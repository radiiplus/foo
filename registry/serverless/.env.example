# GitHub OAuth app used to identify publishing users. Enable Device Flow in
# the app settings for `foo login`; the web flow uses the callback allowlist.
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_OAUTH_CALLBACKS=https://your-project.web.app/auth/callback

# Generate with PowerShell:
# $bytes=[byte[]]::new(32); $rng=[Security.Cryptography.RandomNumberGenerator]::Create(); $rng.GetBytes($bytes); $rng.Dispose(); [Convert]::ToBase64String($bytes)
OAUTH_STATE_SECRET=replace_with_a_random_32_byte_base64_value

# Stable HMAC key used to pseudonymize authenticated GitHub IDs in registry
# ownership records. Keep this key stable; rotating it requires a registry migration.
OWNERSHIP_SECRET=replace_with_a_different_random_32_byte_base64_value

# Server credential used only to commit to the registry repository.
GITHUB_REPOSITORY=radiiplus/foo.registry
GITHUB_BRANCH=main
GITHUB_TOKEN=your_github_repository_token

# Public Git repository consumed by read-only discovery endpoints.
REGISTRY_SOURCE=https://raw.githubusercontent.com/radiiplus/foo.registry/main
