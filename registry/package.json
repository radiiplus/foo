{
  "name": "@foo/registry",
  "private": true,
  "type": "module",
  "workspaces": [
    "ui",
    "serverless"
  ],
  "scripts": {
    "dev": "npm run dev:api",
    "dev:api": "tsx watch server.ts",
    "dev:ui": "npm run dev --workspace @foo/ui",
    "build": "npm run build --workspace @foo/ui",
    "bootstrap": "node --env-file=serverless/supabase/functions/.env repository/scripts/bootstrap.mjs",
    "materialize": "node --env-file=serverless/supabase/functions/.env repository/scripts/materialize.mjs",
    "standard": "node --env-file=serverless/supabase/functions/.env repository/scripts/standard.mjs && node repository/scripts/index.mjs",
    "check": "tsc -p tsconfig.json",
    "test": "node --test repository/test/index.mjs && tsx --test test/*.ts",
    "test:deno": "npm run test --workspace @foo/serverless"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6"
  }
}
