-- Combines, trims, and splits text using byte offsets and ASCII whitespace.
use sequence as items.
use joining as direct.
use "sequence" function sized[T](length unsigned) giving failable sequence of T.
public use "text" function concatenate(left text, right text) giving failable text.
public use "text" function slice(content text, first unsigned, last unsigned) giving failable text.
public use "text" function find(content text, value text) giving optional unsigned.
public use "text" function release(content text) giving failable nothing.
public function length(content text) giving unsigned {
  give lengthof(content).
}
public function trim(content text) giving failable text {
  dynamic first of type unsigned is 0.
  dynamic last of type unsigned is length(content).
  while first less than last {
    constant value is content at first.
    when value is 32 or value is 9 or value is 10 or value is 13 or value is 11 or value is 12 {
      increase first by 1.
    } otherwise { stop. }
  }
  while last greater than first {
    constant value is content at (last subtract 1).
    when value is 32 or value is 9 or value is 10 or value is 13 or value is 11 or value is 12 {
      set last to last subtract 1.
    } otherwise { stop. }
  }
  give slice(content, first, last) try.
}
public function join(left text, right text, output sequence of byte) giving boolean {
  give direct.join(left, right, output).
}
public function join_into(left text, right text, output sequence of byte) giving boolean {
  give join(left, right, output).
}
public function starts(content text, prefix text) giving boolean {
  when length(prefix) greater than length(content) {
    give false.
  }
  dynamic index of type unsigned is 0.
  while index less than length(prefix) {
    when content at index is not prefix at index {
      give false.
    }
    increase index by 1.
  }
  give true.
}
public function ends(content text, suffix text) giving boolean {
  constant size is length(content).
  constant span is length(suffix).
  when span greater than size {
    give false.
  }
  dynamic index of type unsigned is 0.
  while index less than span {
    when content at (size subtract span plus index) is not suffix at index {
      give false.
    }
    increase index by 1.
  }
  give true.
}
public function contains(content text, value text) giving boolean {
  give find(content, value) is not null.
}
public function split(content text, separator text) giving failable sequence of text {
  constant width is length(separator).
  constant size is length(content).
  when width is 0 {
    give fail(Error.Separator).
  }
  dynamic count of type unsigned is 1.
  dynamic cursor of type unsigned is 0.
  while cursor plus width less than or equal to size {
    dynamic matches is true.
    dynamic index of type unsigned is 0.
    while index less than width {
      when content at (cursor plus index) is not separator at index {
        set matches to false.
        stop.
      }
      set index to index plus 1.
    }
    when matches {
      set count to count plus 1.
      set cursor to cursor plus width.
    } otherwise {
      set cursor to cursor plus 1.
    }
  }
  dynamic result is sized[text](count) try.
  after error {
    for each part in result {
      release(part) fallback nothing.
    }
    items.release[text](result) fallback nothing.
  }
  dynamic first of type unsigned is 0.
  set cursor to 0.
  dynamic position of type unsigned is 0.
  while cursor plus width less than or equal to size {
    dynamic matches is true.
    dynamic index of type unsigned is 0.
    while index less than width {
      when content at (cursor plus index) is not separator at index {
        set matches to false.
        stop.
      }
      set index to index plus 1.
    }
    when matches {
      constant part is slice(content, first, cursor) try.
      set result at position to part.
      set position to position plus 1.
      set cursor to cursor plus width.
      set first to cursor.
    } otherwise {
      set cursor to cursor plus 1.
    }
  }
  set result at position to slice(content, first, size) try.
  give result.
}
