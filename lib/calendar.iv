-- Provides validated Gregorian dates and fixed UTC offsets.
public define civil as record {
  year of type integer.
  month of type unsigned.
  day of type unsigned.
}.
public define offset as record {
  minutes of type integer.
}.
public define stamp as record {
  date of type civil.
  hour of type unsigned.
  minute of type unsigned.
  second of type unsigned.
  zone of type offset.
}.
public function leap(year integer) giving boolean {
  when year remainder 400 is 0 {
    give true.
  }
  when year remainder 100 is 0 {
    give false.
  }
  give year remainder 4 is 0.
}
public function days(year integer, month unsigned) giving unsigned {
  when month is 2 {
    when leap(year) {
      give 29.
    }
    give 28.
  }
  when month is 4 or month is 6 or month is 9 or month is 11 {
    give 30.
  }
  give 31.
}
public function date(year integer, month unsigned, day unsigned) giving failable civil {
  when month less than 1 or month greater than 12 {
    give fail(Error.Date).
  }
  when day less than 1 or day greater than days(year, month) {
    give fail(Error.Date).
  }
  give civil(year, month, day).
}
public function zone(minutes integer) giving failable offset {
  when minutes less than (0 subtract 1439) or minutes greater than 1439 {
    give fail(Error.Zone).
  }
  give offset(minutes).
}
public function moment(date civil, hour unsigned, minute unsigned, second unsigned, zone offset) giving failable stamp {
  when hour greater than 23 or minute greater than 59 or second greater than 59 {
    give fail(Error.Time).
  }
  give stamp(date, hour, minute, second, zone).
}
