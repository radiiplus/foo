-- Keeps values from unrelated physical dimensions in distinct generic types.
public define measure[D] as record {
  value of type decimal.
}.
public define length as opaque.
public define mass as opaque.
public define temperature as opaque.
public function quantity[D](value decimal) giving measure[D] {
  give measure[D](value).
}
public function add[D](left measure[D], right measure[D]) giving measure[D] {
  give measure[D](left.value plus right.value).
}
public function difference[D](left measure[D], right measure[D]) giving measure[D] {
  give measure[D](left.value subtract right.value).
}
public function scale[D](value measure[D], factor decimal) giving measure[D] {
  give measure[D](value.value multiply factor).
}
public function meters(value decimal) giving measure[length] {
  give measure[length](value).
}
public function kilograms(value decimal) giving measure[mass] {
  give measure[mass](value).
}
public function celsius(value decimal) giving measure[temperature] {
  give measure[temperature](value).
}
