-- Declares executable test assertions.
public use "testing" function expect(value boolean) giving nothing.
public use "testing" function number(actual unsigned, expected unsigned) giving nothing.
public use "testing" function positive(value unsigned) giving nothing.
public use "testing" function real(actual decimal, expected decimal) giving nothing.
public use "testing" function point(actual optional unsigned 32, expected unsigned 32) giving nothing.
public function same[T](actual T, expected T) giving nothing where T is Equatable {
  expect(actual is expected).
}
public define Generator[T] as record {
  sample of type function taking (unsigned) giving T.
}.
public function generate[T](count unsigned, generator Generator[T], property function taking (T) giving boolean) giving nothing {
  constant produce is generator.sample.
  dynamic index of type unsigned is 0.
  while index less than count {
    expect(property(produce(index))).
    set index to index plus 1.
  }
}
public function every(count unsigned, property function taking (unsigned) giving boolean) giving nothing {
  dynamic index of type unsigned is 0.
  while index less than count {
    expect(property(index)).
    set index to index plus 1.
  }
}
