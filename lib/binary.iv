-- Portable unsigned integer encodings over owned byte sequences.
-- Results from encode and fixed must be released with sequence.release[byte].
public define decoded as record {
  value of type unsigned.
  next of type unsigned.
}.
-- Canonical unsigned LEB128; at most ten bytes for an unsigned value.
public use "binary" function encode(value unsigned) giving failable sequence of byte.
use "binary" function scan(source sequence of constant byte, offset unsigned) giving failable unsigned.
use "binary" function next(source sequence of constant byte, offset unsigned) giving failable unsigned.
public function decode(source sequence of constant byte, offset unsigned) giving failable decoded {
  give decoded(scan(source, offset) try, next(source, offset) try).
}

-- Fixed-width encoding accepts 1..8 bytes and "little" or "big" order.
use "binary" function octet(value unsigned) giving failable byte.
use "binary" function widen(value byte) giving unsigned.
use sequence as items.
public function fixed(value unsigned, width unsigned, order text) giving failable sequence of byte {
  when width less than 1 or width greater than 8 or (order is not "little" and order is not "big") {
    give fail(Error.InvalidInput).
  }
  when width less than 8 {
    dynamic limit of type unsigned is 1.
    dynamic index of type unsigned is 0.
    while index less than width {
      set limit to limit multiply 256.
      increase index by 1.
    }
    when value greater than or equal to limit { give fail(Error.InvalidInput). }
  }
  dynamic output is items.sized[byte](width) try.
  after error { items.release[byte](output) fallback nothing. }
  dynamic rest is value.
  dynamic index of type unsigned is 0.
  while index less than width {
    dynamic slot is index.
    when order is "big" { set slot to width subtract index subtract 1. }
    set output at slot to octet(rest remainder 256) try.
    set rest to rest divide 256.
    increase index by 1.
  }
  give output.
}
public function parse(source sequence of constant byte, offset unsigned, width unsigned, order text) giving failable unsigned {
  when width less than 1 or width greater than 8 or (order is not "little" and order is not "big") {
    give fail(Error.InvalidInput).
  }
  constant extent is items.extent[byte](source).
  when offset greater than extent or width greater than extent subtract offset {
    give fail(Error.Bounds).
  }
  dynamic value of type unsigned is 0.
  dynamic index of type unsigned is 0.
  while index less than width {
    dynamic slot is index.
    when order is "little" { set slot to width subtract index subtract 1. }
    set value to value multiply 256 plus widen(source at (offset plus slot)).
    increase index by 1.
  }
  give value.
}
