-- Stores typed key/value pairs with equality-based lookup.
use sequence as items.
public define entry[K, V] as record {
  key of type K.
  value of type V.
}.
public define dictionary[K, V] as record {
  entries of type sequence of entry[K, V].
}.
public function create[K, V] giving dictionary[K, V] {
  give dictionary[K, V](items.create[entry[K, V]]).
}
public function length[K, V](collection dictionary[K, V]) giving unsigned {
  give items.length[entry[K, V]](collection.entries).
}
public function get[K, V](collection dictionary[K, V], key K) giving failable V where K is Equatable {
  for each row in collection.entries {
    when row.key is key {
      give row.value.
    }
  }
  give fail(Error.Missing).
}
public function contains[K, V](collection dictionary[K, V], key K) giving boolean where K is Equatable {
  for each row in collection.entries {
    when row.key is key {
      give true.
    }
  }
  give false.
}
public function put[K, V](collection dictionary[K, V], key K, value V) giving failable dictionary[K, V] where K is Equatable {
  dynamic index of type unsigned is 0.
  for each row in collection.entries {
    when row.key is key {
      dynamic result is items.copy[entry[K, V]](collection.entries) try.
      set result at index to entry[K, V](key, value).
      give dictionary[K, V](result).
    }
    set index to index plus 1.
  }
  give dictionary[K, V](items.append[entry[K, V]](collection.entries, entry[K, V](key, value)) try).
}
public function remove[K, V](collection dictionary[K, V], key K) giving failable dictionary[K, V] where K is Equatable {
  dynamic index of type unsigned is 0.
  for each row in collection.entries {
    when row.key is key {
      give dictionary[K, V](items.remove[entry[K, V]](collection.entries, index) try).
    }
    set index to index plus 1.
  }
  give dictionary[K, V](items.copy[entry[K, V]](collection.entries) try).
}
public function keys[K, V](collection dictionary[K, V]) giving failable sequence of K {
  dynamic result is items.sized[K](length[K, V](collection)) try.
  after error { items.release[K](result) fallback nothing. }
  dynamic index of type unsigned is 0.
  for each row in collection.entries {
    set result at index to row.key.
    increase index by 1.
  }
  give result.
}
public function values[K, V](collection dictionary[K, V]) giving failable sequence of V {
  dynamic result is items.sized[V](length[K, V](collection)) try.
  after error { items.release[V](result) fallback nothing. }
  dynamic index of type unsigned is 0.
  for each row in collection.entries {
    set result at index to row.value.
    increase index by 1.
  }
  give result.
}
public function release[K, V](collection dictionary[K, V]) giving failable nothing {
  items.release[entry[K, V]](collection.entries) try.
  give nothing.
}
