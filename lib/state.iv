-- Applies application-defined transitions without adding state-machine syntax.
public define machine[S, E] as record {
  value of type S.
  change of type function taking (S, E) giving failable S.
}.
public function create[S, E](value S, change function taking (S, E) giving failable S) giving machine[S, E] {
  give machine[S, E](value, change).
}
public function step[S, E](current machine[S, E], event E) giving failable machine[S, E] {
  constant value is current.change(current.value, event) try.
  give machine[S, E](value, current.change).
}
