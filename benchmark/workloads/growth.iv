-- Measures newest-version appends while retaining one older logical version.
use sequence as items.
use testing as check.

dynamic values is items.create[unsigned].
dynamic older is items.create[unsigned].
dynamic index of type unsigned is 0.
while index less than 10`000 {
  set values to items.append[unsigned](values, index) try.
  increase index by 1.
  when index is 5`000 { set older to values. }
}

constant marker of type unsigned is 50`000.
constant branched is items.append[unsigned](older, marker) try.
after {
  items.release[unsigned](older) fallback nothing.
  items.release[unsigned](values) fallback nothing.
  items.release[unsigned](branched) fallback nothing.
}

check.number(items.length[unsigned](values), 10`000).
check.number(values at 9`999, 9`999).
check.number(items.length[unsigned](older), 5`000).
check.number(older at 4`999, 4`999).
check.number(items.length[unsigned](branched), 5`001).
check.number(branched at 5`000, 50`000).
check.number(values at 5`000, 5`000).
