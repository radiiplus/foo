-- Measures checked arithmetic when the programmer leaves hot state global.
use testing as check.
use system as machine.

dynamic index of type unsigned is 0.
dynamic checksum of type unsigned is 0.
dynamic limit of type unsigned is 10`000`000.
when machine.cores try greater than 0 { increase limit by 1. }

while index less than limit {
  set checksum to checksum plus index.
  increase index by 1.
}

check.same(checksum, 50`000`005`000`000).
