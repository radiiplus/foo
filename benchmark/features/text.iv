use text as words.
use system as machine.
use testing as check.

constant haystack is words.concatenate("abcdefghijklmnop", "abcdefghijklmnop") try.
after { words.release(haystack) fallback nothing. }
dynamic limit of type unsigned is 500`000.
when machine.cores try greater than 0 { increase limit by 1. }
dynamic index of type unsigned is 0.
dynamic checksum of type unsigned is 0.
while index less than limit {
  constant position is words.find(haystack, "mnop").
  check.expect(position is 12).
  set checksum to checksum plus 12.
  increase index by 1.
}
check.number(checksum, limit multiply 12).
