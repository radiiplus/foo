-- Measures successful typed failure propagation through postfix try.
use testing as check.
use system as machine.

function next(value unsigned) giving failable unsigned keeping call {
  give value plus 1.
}

dynamic index of type unsigned is 0.
dynamic checksum of type unsigned is 0.
dynamic limit of type unsigned is 10`000`000.
when machine.cores try greater than 0 { increase limit by 1. }

while index less than limit {
  constant value is next(index) try.
  set checksum to checksum plus value.
  increase index by 1.
}

check.positive(checksum).
