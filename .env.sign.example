# Copy this file to .env.sign and set the release identity before running `npm run key`.
FOOSIGNNAME=FOO Releases
FOOSIGNEMAIL=maintainer@example.com
FOOSIGNEXPIRES=2y
FOOSIGNBACKUP=
FOOSIGNPUBLIC=
FOOWSL=Ubuntu-22.04
FOOGPG=gpg
FOOGPGHOME=

# The key generator fills this with the full secret-key fingerprint.
FOOSIGNKEY=
