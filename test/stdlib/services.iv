-- Exercises portable files, text, clocks, threads, and TCP connections.
use io as io.
use fs as files.
use net as network.
use process as process.
use thread as tasks.
use task as async_tasks.
use time as clock.
use text as words.
use sequence as items.
use log as log.
use testing as check.
use "c" function verify() of type nothing.
mutable count of type integer is 0.
function work() of type nothing { set count to count plus 1. give. }
function scoped_work(value of type integer 64) of type nothing for c { set count to count plus value. give. }
start() {
  constant joined is try words.concatenate("FO", "O").
  constant trimmed is try words.trim("  FOO  ").
  after { words.release(joined) catch nothing. words.release(trimmed) catch nothing. }
  check.same(joined, trimmed).
  constant parts is try words.split("four::four::", "::").
  after { for each part in parts { words.release(part) catch nothing. } items.release[text](parts) catch nothing. }
  check.expect(items.length[text](parts) is 3).
  check.same(parts at 0, "four").
  check.same(parts at 2, "").
  try files.directory(".artifacts/service").
  constant path is try files.join(".artifacts/service", "message.txt").
  after { words.release(path) catch nothing. }
  try files.write(path, "FOO" plus newline plus "44").
  constant content is try files.read(path).
  after { words.release(content) catch nothing. }
  check.same(content, "FOO" plus newline plus "44").
  constant file is try files.open(path, "read").
  after { io.close(file) catch nothing. }
  check.expect((try files.position(file)) is 0).
  check.expect((try files.size(file)) is 6).
  try files.seek(file, (0 subtract 2), "end").
  check.expect((try files.position(file)) is 4).
  constant tail is try io.read(file, 2).
  after { words.release(tail) fallback nothing. }
  check.same(tail, "44").
  try files.seek(file, 0, "start").
  try files.flush(file).
  constant line is try io.line(file).
  after { words.release(line) catch nothing. }
  check.same(line, "FOO").
  constant missing is files.read(".artifacts/service/missing") catch "missing".
  check.same(missing, "missing").
  check.expect(process.count() greater than 0).
  check.expect((try process.run("exit 7")) is 7).
  check.same(process.environment("FOO_MISSING_VARIABLE_7F19") catch "missing", "missing").
  constant argument is try process.argument(0).
  after { words.release(argument) catch nothing. }
  check.expect(words.length(argument) greater than 0).
  constant before is try clock.current().
  try clock.sleep(1000000).
  check.expect((try clock.current()) greater than before).
  constant task is try tasks.spawn(work).
  try tasks.wait(task).
  check.expect(count is 1).
  constant executor is try async_tasks.executor().
  constant scope is try async_tasks.scope().
  check.expect(async_tasks.backend() is at least 0).
  check.expect(async_tasks.launch(scope, scoped_work, 2)).
  async_tasks.join(scope).
  check.expect(count is 3).
  check.expect(async_tasks.label("foo-test")).
  try clock.measure(work).
  check.expect(count is 4).
  constant mutex is try tasks.mutex().
  constant condition is try tasks.condition().
  try tasks.lock(mutex).
  try tasks.signal(condition).
  try tasks.unlock(mutex).
  try tasks.close(mutex).
  try tasks.close(condition).
  constant listener is try network.listen("127.0.0.1", 0).
  after { network.close(listener) catch nothing. }
  constant client is try network.connect("127.0.0.1", try network.port(listener)).
  after { network.close(client) catch nothing. }
  try network.nodelay(client, true).
  try network.keepalive(client, true).
  constant server is try network.accept(listener).
  after { network.close(server) catch nothing. }
  check.expect((try network.sendSome(client, "44")) is 2).
  try network.shutdown(client, "write").
  constant received is try network.receive(server, 2).
  after { words.release(received) catch nothing. }
  check.same(received, "44").
  try log.message("services passed").
  verify().
}
