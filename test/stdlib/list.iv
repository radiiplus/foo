-- Checks list growth, order, bounds and borrowed-item ownership.
use "../../std/list.iv".
use "../../std/memory.iv" as heap.
use testing.
function bounds(collection pointer to List) giving failable text {
  constant item is get(collection, 10) try.
  give "unexpected".
}
start {
  constant allocator is heap.system.
  constant first is heap.allocate(allocator, 4) try.
  constant second is heap.allocate(allocator, 4) try.
  heap.copy(allocator, first, "FOO!") try.
  heap.copy(allocator, second, "list") try.
  constant collection is create try.
  number(length(collection) try, 0).
  push(collection, first) try.
  push(collection, second) try.
  push(collection, first) try.
  push(collection, second) try.
  push(collection, first) try.
  push(collection, second) try.
  push(collection, first) try.
  push(collection, second) try.
  push(collection, first) try.
  push(collection, second) try.
  number(length(collection) try, 10).
  same(heap.view(allocator, get(collection, 0) try, 4) try, "FOO!").
  same(heap.view(allocator, get(collection, 9) try, 4) try, "list").
  same(bounds(collection) fallback "bounds", "bounds").
  close(collection) try.
  number(length(collection) fallback 44, 44).
  same(heap.view(allocator, first, 4) try, "FOO!").
  heap.release(allocator, first) try.
  heap.release(allocator, second) try.
  give nothing.
}
