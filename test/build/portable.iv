-- Exercises build behavior.
use testing as check.
use crypto as secret.
use compress as zip.
use unicode as letters.
use json as data.
use system as machine.
use atomic as atom.
use buffer as memory.
function twice(value unsigned) giving unsigned {
  give value multiply 2.
}
function line giving text {
  give newline.
}
function greeting(value text) giving text {
  give value plus newline plus "World".
}
function recover giving text {
  give zip.unpack("bad", "gzip", 8) fallback "recovered".
}
function digest giving failable text {
  give secret.hash("abc").
}
function fail giving text {
  check.expect(false).
  give "bad".
}
start {
  check.same(newline, newline).
  check.same(line, newline).
  check.same("Hello" plus newline plus "World", ("Hello" plus newline plus "World")).
  check.same(greeting("Hello"), ("Hello" plus newline plus "World")).
  check.same("" plus newline plus newline plus "λ\0", (newline plus newline plus "λ\0")).
  check.number(twice(21), 42).
  constant left of type vector[4, decimal] is splat(2.0).
  constant right of type vector[4, decimal] is splat(3.0).
  constant result is reduce(left multiply right, "add").
  check.real(result, 24.0).
  check.same(digest try, "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad").
  check.same(secret.hash("abc") fallback fail, "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad").
  constant key is "01234567890123456789012345678901".
  constant nonce is "012345678901234567890123".
  constant encrypted is secret.seal("hello", key, nonce, "context") try.
  check.same(secret.open(encrypted, key, nonce, "context") try, "hello").
  check.same(secret.open(encrypted, key, nonce, "wrong") fallback "rejected", "rejected").
  constant signer is secret.key(key) try.
  constant signature is secret.sign("message", key) try.
  check.expect(secret.verify("message", signature, signer)).
  constant password is secret.password("correct horse") try.
  check.expect(secret.confirm("correct horse", password) try).
  constant entropy is secret.random(32) try.
  unsafe {
    memory.free(entropy) try.
  }
  constant encoded is zip.pack("hello hello hello", "gzip") try.
  check.same(zip.unpack(encoded, "gzip", 17) try, "hello hello hello").
  check.same(zip.unpack(encoded, "gzip", 3) fallback "limited", "limited").
  constant zlib is zip.pack("zlib", "zlib") try.
  check.same(zip.unpack(zlib, "zlib", 4) try, "zlib").
  check.same(recover, "recovered").
  check.expect(letters.valid("aé😀")).
  constant units is letters.wide("aé😀") try.
  check.same(letters.narrow(units) try, "aé😀").
  unsafe {
    memory.words(units) try.
  }
  constant cursor is letters.scan("aé😀") try.
  after {
    letters.release(cursor).
  }
  check.point(letters.next(cursor), 97).
  check.point(letters.next(cursor), 233).
  check.point(letters.next(cursor), 128512).
  constant document is data.parse("{\"number\":123456789012345678901234567890,\"nested\":[true,null,\"é\"]}") try.
  after {
    data.release(document).
  }
  check.same(data.field(document, "number") try, "123456789012345678901234567890").
  check.same(data.kind(document), "object").
  data.set(document, "number", "42") try.
  check.same(data.field(document, "number") try, "42").
  check.same(data.quote("a\"b") try, "\"a\\\"b\"").
  check.same(data.quote(("a" plus newline plus "b")) try, "\"a\\nb\"").
  constant items is data.parse("[]") try.
  after {
    data.release(items).
  }
  data.append(items, "123456789012345678901234567890") try.
  check.same(data.item(items, 0) try, "123456789012345678901234567890").
  check.same(data.write(items) try, "[123456789012345678901234567890]").
  check.same(data.item(items, 9) fallback "missing", "missing").
  constant stream is data.stream try.
  after {
    data.close(stream).
  }
  data.feed(stream, "[", false) try.
  check.same(data.next(stream) try, "array_begin").
  check.same(data.next(stream) try, "more").
  data.feed(stream, "42,\"hello\",true,null]", true) try.
  check.same(data.next(stream) try, "number").
  check.same(data.data(stream) try, "42").
  check.same(data.next(stream) try, "string").
  check.same(data.data(stream) try, "hello").
  check.same(data.next(stream) try, "true").
  check.same(data.next(stream) try, "null").
  check.same(data.next(stream) try, "array_end").
  check.same(data.next(stream) try, "end_of_document").
  constant counter is atom.create(7) try.
  after {
    atom.release(counter).
  }
  check.number(atom.add(counter, 2, "relaxed") try, 7).
  check.number(atom.load(counter, "acquire") try, 9).
  check.expect(atom.replace(counter, 9, 42, "both") try).
  check.number(atom.swap(counter, 0, "sequential") try, 42).
  check.positive(machine.page).
  constant hostname is machine.host try.
  check.expect(letters.valid(hostname)).
  give nothing.
}
