-- Exercises sentence calls and bounded byte copying without backend syntax.
use "../../lib/memory.iv".
use io as io.
use text as words.
use testing as check.
dynamic rejected is false.
function caught giving nothing {
  set rejected to true.
  give nothing.
}
start {
  constant destination is allocate 4 try.
  transfer("FOO!", destination) try.
  check.expect(destination at 0 is 70).
  check.expect(destination at 3 is 33).
  transfer(destination, destination) try.
  check.expect(destination at 3 is 33).
  constant smaller is allocate 2 try.
  transfer("too long", smaller) fallback caught.
  check.expect(rejected).
  check.expect(smaller at 0 is 0).
  clear(destination).
  check.expect(destination at 0 is 0).
  check.expect((compare("FOO", "FOO")) is 0).
  constant size is words.length("FOO").
  check.expect(size is 3).
  constant joined is words.concatenate("FO", "O") try.
  after {
    words.release(joined) fallback nothing.
  }
  check.same(joined, "FOO").
  display("sentences passed" plus newline).
}
