-- Exercises reusable abstractions built from the current language.
use codec as codecs.
use contract as contracts.
use state as states.
use testing as check.
use time as clock.
use iterator as cursors.
use transaction as transactions.
use units as units.
use calendar as calendar.
function keep(value text) giving failable text {
  give value.
}
function transition(value integer, event integer) giving failable integer {
  constant next is value plus event.
  give next.
}
function bounded(index unsigned) giving boolean {
  give index is less than 4.
}
function sample(index unsigned) giving unsigned {
  give index plus 1.
}
function positive(value unsigned) giving boolean {
  give value is greater than 0.
}
function prepare giving failable nothing {
  give nothing.
}
function commit giving failable nothing {
  give nothing.
}
function rollback giving nothing {
  give nothing.
}
function work giving failable nothing {
  give nothing.
}
define Step as choice {
  item(unsigned).
  done.
}.
define Outcome[T] as choice {
  picked(T).
  ended.
}.
define Person as record {
  name of type text.
  age of type integer.
}.
function next(index unsigned) giving Step {
  when index is less than 3 {
    give item(index).
  }
  give done.
}
function finish giving Outcome[unsigned] {
  give ended.
}
function proceed(index unsigned) giving failable cursors.step[unsigned, unsigned] {
  when index is less than 2 {
    give cursors.item[unsigned, unsigned](index, index plus 1).
  }
  give cursors.done[unsigned, unsigned](index).
}
test "library abstractions compose" {
  constant outcome is picked[unsigned](7).
  match outcome {
    case picked(value) {
      check.number(value, 7).
    }
    case ended {
      check.expect(false).
    }
  }
  match finish {
    case picked(value) {
      check.expect(false).
    }
    case ended {
      check.expect(true).
    }
  }
  constant person is Person(age 37, name "Ada").
  constant Person(name, age) is person.
  check.same(name, "Ada").
  check.expect(age is 37).
  constant codec is codecs.codec[text](keep, keep).
  constant encode is codec.encode.
  constant decode is codec.decode.
  check.same(encode("FOO") fallback "failed", "FOO").
  check.same(decode("FOO") fallback "failed", "FOO").
  constant machine is states.create[integer, integer](40, transition).
  constant changed is states.step[integer, integer](machine, 2) fallback machine.
  contracts.ensure(changed.value is 42).
  constant duration is clock.millis(1).
  check.number(duration.nanoseconds, 1000000).
  constant elapsed is clock.elapsed(clock.instant(10), clock.instant(15)).
  check.number(elapsed.nanoseconds, 5).
  check.every(4, bounded).
  constant generator is check.generator[unsigned](sample).
  check.generate[unsigned](3, generator, positive).
  constant participant is transactions.participant(prepare, commit, rollback).
  transactions.execute(participant, work) fallback nothing.
  constant seed of type unsigned is 0.
  constant cursor is cursors.create[unsigned, unsigned](seed, proceed).
  constant first is cursors.next[unsigned, unsigned](cursor) fallback cursors.done[unsigned, unsigned](seed).
  check.expect(not first.finished and first.value is not null).
  constant length is units.add[units.length](units.meters(1.5), units.meters(2.0)).
  check.real(length.value, 3.5).
  constant day is calendar.date(2024, 2, 29) fallback calendar.civil(1970, 1, 1).
  check.expect(day.year is 2024 and day.day is 29).
  constant zone is calendar.zone(60) fallback calendar.offset(0).
  constant moment is calendar.moment(day, 12, 30, 0, zone) fallback calendar.stamp(day, 0, 0, 0, calendar.offset(0)).
  check.expect(moment.hour is 12 and moment.zone.minutes is 60).
  dynamic index of type unsigned is 0.
  dynamic running is true.
  while running {
    match next(index) {
      case item(value) {
        check.number(value, index).
        set index to index plus 1.
      }
      case done {
        set running to false.
      }
    }
  }
  check.number(index, 3).
}
