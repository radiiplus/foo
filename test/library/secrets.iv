use "../../lib/crypto.iv" as crypto.
use sequence as items.
use testing as check.

function rejects(cipher sequence of constant byte, key sequence of constant byte,
    nonce sequence of constant byte, extra sequence of constant byte) giving failable boolean {
  constant plain is crypto.decrypt("xchacha20poly1305", cipher, key, nonce, extra) try.
  items.release[byte](plain) try.
  give false.
}
function unsupported(data sequence of constant byte, key sequence of constant byte,
    nonce sequence of constant byte, extra sequence of constant byte) giving failable boolean {
  constant cipher is crypto.encrypt("unknown", data, key, nonce, extra) try.
  items.release[byte](cipher) try.
  give false.
}
function oversized(seed sequence of constant byte, label sequence of constant byte) giving failable boolean {
  constant bytes is crypto.sample(seed, label, 1048577) try.
  items.release[byte](bytes) try.
  give false.
}

test "configured AEAD and locked key storage" {
  constant key is items.sized[byte](32) try.
  constant nonce is items.sized[byte](24) try.
  constant brief is items.sized[byte](12) try.
  constant data is items.sized[byte](3) try.
  constant extra is items.sized[byte](1) try.
  after {
    items.release[byte](key) fallback nothing.
    items.release[byte](nonce) fallback nothing.
    items.release[byte](brief) fallback nothing.
    items.release[byte](data) fallback nothing.
    items.release[byte](extra) fallback nothing.
  }
  dynamic index of type unsigned is 0.
  while index less than 32 {
    set key at index to 7.
    increase index by 1.
  }
  set data at 0 to 97.
  set data at 1 to 0.
  set data at 2 to 98.
  set extra at 0 to 99.
  check.expect(crypto.available("xchacha20poly1305")).
  check.expect(not crypto.available("unknown" )).
  check.expect(unsupported(data, key, nonce, extra) fallback true).
  constant sealed is crypto.encrypt("xchacha20poly1305", data, key, nonce, extra) try.
  after { items.release[byte](sealed) fallback nothing. }
  check.expect(items.length[byte](sealed) is 19).
  constant opened is crypto.decrypt("xchacha20poly1305", sealed, key, nonce, extra) try.
  after { items.release[byte](opened) fallback nothing. }
  check.expect(crypto.compare(data, opened)).
  constant secure is crypto.protect(key) try.
  after { crypto.forget(secure). }
  constant ciphered is crypto.encipher("xchacha20poly1305", data, secure, nonce, extra) try.
  after { items.release[byte](ciphered) fallback nothing. }
  check.expect(crypto.compare(sealed, ciphered)).
  constant revealed is crypto.decipher("xchacha20poly1305", ciphered, secure, nonce, extra) try.
  after { items.release[byte](revealed) fallback nothing. }
  check.expect(crypto.compare(data, revealed)).
  set sealed at 0 to 0.
  check.expect(rejects(sealed, key, nonce, extra) fallback true).
  when crypto.available("aes256gcm") {
    constant aes is crypto.encrypt("aes256gcm", data, key, brief, extra) try.
    after { items.release[byte](aes) fallback nothing. }
    constant decoded is crypto.decrypt("aes256gcm", aes, key, brief, extra) try.
    after { items.release[byte](decoded) fallback nothing. }
    check.expect(crypto.compare(data, decoded)).
  }
}

test "deterministic labeled test byte streams" {
  constant seed is items.sized[byte](32) try.
  after { items.release[byte](seed) fallback nothing. }
  constant empty is items.create[byte].
  constant label is items.sized[byte](1) try.
  after { items.release[byte](label) fallback nothing. }
  set label at 0 to 1.
  constant one is crypto.sample(seed, empty, 64) try.
  constant again is crypto.sample(seed, empty, 64) try.
  constant other is crypto.sample(seed, label, 64) try.
  after {
    items.release[byte](one) fallback nothing.
    items.release[byte](again) fallback nothing.
    items.release[byte](other) fallback nothing.
  }
  check.expect(crypto.compare(one, again)).
  check.expect(not crypto.compare(one, other)).
  check.expect(items.length[byte](one) is 64).
  check.expect(oversized(seed, empty) fallback true).
}
