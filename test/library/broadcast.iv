use matrix as grid.
use tensor as cells.
use sequence as items.
use testing as check.

function incompatible(value cells.tensor, shape sequence of unsigned) giving failable boolean {
  constant result is cells.broadcast(value, shape) try.
  cells.release(result) try.
  give false.
}

function unequal(left grid.matrix, right grid.matrix) giving failable boolean {
  constant result is grid.hadamard(left, right) try.
  grid.release(result) try.
  give false.
}

function mismatch(left cells.tensor, right cells.tensor) giving failable boolean {
  constant result is cells.hadamard(left, right) try.
  cells.release(result) try.
  give false.
}

test "matrix elementwise product checks shape and owns values" {
  dynamic left is grid.create(2, 2) try.
  after { grid.release(left) fallback nothing. }
  dynamic right is grid.create(2, 2) try.
  after { grid.release(right) fallback nothing. }
  set left.values at 0 to 2.0.
  set left.values at 1 to 3.0.
  set left.values at 2 to 4.0.
  set left.values at 3 to 5.0.
  set right.values at 0 to 1.0.
  set right.values at 1 to 2.0.
  set right.values at 2 to 3.0.
  set right.values at 3 to 4.0.
  dynamic result is grid.hadamard(left, right) try.
  after { grid.release(result) fallback nothing. }
  check.real(result.values at 0, 2.0).
  check.real(result.values at 1, 6.0).
  check.real(result.values at 2, 12.0).
  check.real(result.values at 3, 20.0).
  set result.values at 0 to 99.0.
  check.real(left.values at 0, 2.0).
  check.real(right.values at 0, 1.0).
  constant wrong is grid.create(1, 4) try.
  after { grid.release(wrong) fallback nothing. }
  check.expect(unequal(left, wrong) fallback true).
  constant empty is grid.create(2, 0) try.
  after { grid.release(empty) fallback nothing. }
  constant blank is grid.hadamard(empty, empty) try.
  after { grid.release(blank) fallback nothing. }
  check.number(blank.rows, 2).
  check.number(blank.columns, 0).
}

test "tensor broadcast aligns trailing axes and owns values" {
  dynamic shape is items.sized[unsigned](3) try.
  after { items.release[unsigned](shape) fallback nothing. }
  set shape at 0 to 2.
  set shape at 1 to 1.
  set shape at 2 to 3.
  dynamic source is cells.create(shape) try.
  after { cells.release(source) fallback nothing. }
  dynamic index of type unsigned is 0.
  dynamic amount of type decimal is 1.0.
  while index less than 6 {
    set source.values at index to amount.
    increase index by 1.
    set amount to amount plus 1.0.
  }
  dynamic target is items.copy[unsigned](shape) try.
  after { items.release[unsigned](target) fallback nothing. }
  set target at 1 to 4.
  dynamic expanded is cells.broadcast(source, target) try.
  after { cells.release(expanded) fallback nothing. }
  check.number(items.length[decimal](expanded.values), 24).
  check.real(expanded.values at 0, 1.0).
  check.real(expanded.values at 3, 1.0).
  check.real(expanded.values at 11, 3.0).
  check.real(expanded.values at 12, 4.0).
  check.real(expanded.values at 23, 6.0).
  set expanded.values at 0 to 99.0.
  check.real(source.values at 0, 1.0).
  set target at 2 to 4.
  check.expect(incompatible(source, target) fallback true).
  set target at 2 to 3.
  set target at 1 to 0.
  constant zero is cells.broadcast(source, target) try.
  after { cells.release(zero) fallback nothing. }
  check.number(items.length[decimal](zero.values), 0).

  constant dimensions is items.sized[unsigned](0) try.
  after { items.release[unsigned](dimensions) fallback nothing. }
  dynamic scalar is cells.create(dimensions) try.
  after { cells.release(scalar) fallback nothing. }
  set scalar.values at 0 to 7.0.
  constant filled is cells.broadcast(scalar, shape) try.
  after { cells.release(filled) fallback nothing. }
  check.number(items.length[decimal](filled.values), 6).
  check.real(filled.values at 0, 7.0).
  check.real(filled.values at 5, 7.0).
  check.expect(incompatible(source, dimensions) fallback true).
}

test "tensor elementwise product requires identical shapes" {
  dynamic shape is items.sized[unsigned](2) try.
  after { items.release[unsigned](shape) fallback nothing. }
  set shape at 0 to 2.
  set shape at 1 to 2.
  dynamic left is cells.create(shape) try.
  after { cells.release(left) fallback nothing. }
  dynamic right is cells.create(shape) try.
  after { cells.release(right) fallback nothing. }
  set left.values at 0 to 1.0.
  set left.values at 1 to 2.0.
  set left.values at 2 to 3.0.
  set left.values at 3 to 4.0.
  set right.values at 0 to 4.0.
  set right.values at 1 to 3.0.
  set right.values at 2 to 2.0.
  set right.values at 3 to 1.0.
  dynamic result is cells.hadamard(left, right) try.
  after { cells.release(result) fallback nothing. }
  check.real(result.values at 0, 4.0).
  check.real(result.values at 1, 6.0).
  check.real(result.values at 2, 6.0).
  check.real(result.values at 3, 4.0).
  set result.values at 0 to 99.0.
  check.real(left.values at 0, 1.0).
  set shape at 0 to 4.
  set shape at 1 to 1.
  constant wrong is cells.create(shape) try.
  after { cells.release(wrong) fallback nothing. }
  check.expect(mismatch(left, wrong) fallback true).
  set shape at 0 to 2.
  set shape at 1 to 0.
  constant empty is cells.create(shape) try.
  after { cells.release(empty) fallback nothing. }
  constant blank is cells.hadamard(empty, empty) try.
  after { cells.release(blank) fallback nothing. }
  check.number(items.length[decimal](blank.values), 0).
}
