use codec as codecs.
use sequence as sequences.
use testing as check.
use text as words.
define Point as record {
  x of type integer 32.
  y of type integer 32.
  active of type boolean.
}.
define Samples as record {
  values of type sequence of integer.
}.
define Maybe as record {
  value of type optional integer.
}.
define Selection as choice {
  chosen(integer).
  missing.
}.
define Narrow as record {
  value of type integer 7.
}.
define Wide as record {
  value of type unsigned 100.
}.
function advance(value unsigned 100) giving unsigned 100 {
  give value plus 1.
}
test "typed codec" {
  constant encoded is codecs.encode[Point](Point(4, 0 subtract 2, true)) fallback "failed".
  after {
    words.release(encoded) fallback nothing.
  }
  check.same(encoded, "{\"x\":4,\"y\":-2,\"active\":true}").
  constant decoded is codecs.decode[Point](encoded) fallback Point(0, 0, false).
  check.expect(decoded.x is 4 and decoded.y is (0 subtract 2) and decoded.active).

  constant empty is sequences.create[integer].
  constant first is sequences.append[integer](empty, 4) try.
  constant values is sequences.append[integer](first, 9) try.
  after {
    sequences.release[integer](first) fallback nothing.
    sequences.release[integer](values) fallback nothing.
  }
  constant encodedSamples is codecs.encode[Samples](Samples(values)) fallback "failed".
  after {
    words.release(encodedSamples) fallback nothing.
  }
  check.same(encodedSamples, "{\"values\":[4,9]}").
  constant unpacked is codecs.decode[Samples](encodedSamples) fallback Samples(empty).
  constant decodedValues is unpacked.values.
  check.expect(sequences.length[integer](decodedValues) is 2).
  check.expect(decodedValues at 0 is 4 and decodedValues at 1 is 9).

  constant encodedMaybe is codecs.encode[Maybe](Maybe(7)) fallback "failed".
  after {
    words.release(encodedMaybe) fallback nothing.
  }
  check.same(encodedMaybe, "{\"value\":7}").
  constant decodedMaybe is codecs.decode[Maybe](encodedMaybe) fallback Maybe(null).
  check.expect(decodedMaybe.value is 7 and 7 is decodedMaybe.value).
  check.expect(8 is not decodedMaybe.value).
  check.expect(decodedMaybe.value is greater than 6).
  constant encodedNone is codecs.encode[Maybe](Maybe(null)) fallback "failed".
  after {
    words.release(encodedNone) fallback nothing.
  }
  check.same(encodedNone, "{\"value\":null}").

  constant encodedChoice is codecs.encode[Selection](chosen(5)) fallback "failed".
  after {
    words.release(encodedChoice) fallback nothing.
  }
  check.same(encodedChoice, "{\"chosen\":5}").
  constant decodedChoice is codecs.decode[Selection](encodedChoice) fallback missing.
  match decodedChoice {
    case chosen(value) {
      check.expect(value is 5).
    }
    case missing {
      check.expect(false).
    }
  }
  constant encodedMissing is codecs.encode[Selection](missing) fallback "failed".
  after {
    words.release(encodedMissing) fallback nothing.
  }
  check.same(encodedMissing, "{\"missing\":{}}").
  constant unknownChoice is codecs.decode[Selection]("{\"unknown\":1}") fallback missing.
  match unknownChoice {
    case chosen(value) {
      check.expect(false).
    }
    case missing {
      check.expect(true).
    }
  }

  constant encodedNarrow is codecs.encode[Narrow](Narrow(63)) fallback "failed".
  after {
    words.release(encodedNarrow) fallback nothing.
  }
  check.same(encodedNarrow, "{\"value\":63}").
  constant decodedNarrow is codecs.decode[Narrow](encodedNarrow) fallback Narrow(0).
  check.expect(decodedNarrow.value is 63).
  constant huge of type unsigned 100 is 18446744073709551616.
  check.expect(advance(huge) is greater than huge).
  constant encodedWide is codecs.encode[Wide](Wide(huge)) fallback "failed".
  after {
    words.release(encodedWide) fallback nothing.
  }
  check.same(encodedWide, "{\"value\":18446744073709551616}").
  constant decodedWide is codecs.decode[Wide](encodedWide) fallback Wide(0).
  check.expect(decodedWide.value is huge).
}
