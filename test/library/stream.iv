-- Checks actual output and length-aware writes including embedded zero bytes.
use "../../lib/stream.iv".
start {
  constant out is output.
  print(out, "Hello from FOO!" plus newline) try.
  write(out, "A\0B") try.
  write(out, "") try.
  close(out) try.
  write(out, newline) try.
  give nothing.
}
