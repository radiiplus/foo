use frame as frames.
use sequence as items.
use testing as check.

function rejects(source sequence of constant byte, offset unsigned, limit unsigned) giving failable boolean {
  constant value is frames.read(source, offset, limit) try.
  frames.release(value) try.
  give false.
}

test "bounded length-prefixed frames" {
  constant payload is items.sized[byte](3) try.
  after { items.release[byte](payload) fallback nothing. }
  set payload at 0 to 0.
  set payload at 1 to 255.
  set payload at 2 to 7.
  constant encoded is frames.pack(payload) try.
  after { items.release[byte](encoded) fallback nothing. }
  check.expect(items.length[byte](encoded) is 4 and encoded at 0 is 3).
  constant parsed is frames.read(encoded, 0, 3) try.
  after { frames.release(parsed) fallback nothing. }
  check.expect(parsed.next is 4).
  check.expect(parsed.data at 0 is 0 and parsed.data at 1 is 255 and parsed.data at 2 is 7).
  set encoded at 1 to 10.
  check.expect(parsed.data at 0 is 0).
  check.expect(rejects(encoded, 0, 2) fallback true).

  constant shifted is items.sized[byte](5) try.
  after { items.release[byte](shifted) fallback nothing. }
  set shifted at 0 to 99.
  dynamic index of type unsigned is 0.
  while index less than 4 {
    set shifted at (index plus 1) to encoded at index.
    increase index by 1.
  }
  constant later is frames.read(shifted, 1, 3) try.
  after { frames.release(later) fallback nothing. }
  check.expect(later.next is 5).

  constant empty is items.create[byte].
  constant blank is frames.pack(empty) try.
  after { items.release[byte](blank) fallback nothing. }
  constant vacant is frames.read(blank, 0, 0) try.
  after { frames.release(vacant) fallback nothing. }
  check.expect(vacant.next is 1 and items.length[byte](vacant.data) is 0).

  constant short is items.sized[byte](2) try.
  after { items.release[byte](short) fallback nothing. }
  set short at 0 to 3.
  set short at 1 to 1.
  check.expect(rejects(short, 0, 3) fallback true).
  set short at 0 to 128.
  set short at 1 to 0.
  check.expect(rejects(short, 0, 3) fallback true).
}
