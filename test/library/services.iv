-- Exercises portable files, text, clocks, threads, and TCP connections.
use io as io.
use file as files.
use net as network.
use dns as names.
use adapter as devices.
use route as paths.
use "../../lib/process.iv" as process.
use "../../lib/resource.iv" as usage.
use thread as tasks.
use task as jobs.
use time as clock.
use text as words.
use sequence as items.
use log as log.
use testing as check.
extern "C" function verify giving nothing.
dynamic count of type integer is 0.
function pulse giving nothing {
  set count to count plus 1.
  give nothing.
}
function accumulate(value integer) giving nothing for c {
  set count to count plus value.
  give nothing.
}
function probe giving failable nothing {
  constant answers is names.query("localhost", "a") try.
  after { names.close(answers) fallback nothing. }
  check.expect((names.count(answers) try) is greater than 0).
  check.expect(words.length(names.name(answers, 0) try) is greater than 0).
  check.expect(words.length(names.data(answers, 0) try) is greater than 0).
  check.expect(words.length(names.kind(answers, 0) try) is greater than 0).
  constant ttl is names.ttl(answers, 0) try.
  check.expect(ttl is less than 18446744073709551615).
}
start {
  constant joined is words.concatenate("FO", "O") try.
  constant trimmed is words.trim("  FOO  ") try.
  after {
    words.release(joined) fallback nothing.
    words.release(trimmed) fallback nothing.
  }
  check.same(joined, trimmed).
  check.expect(words.find(trimmed, "OO") is not null).
  check.expect(words.find(trimmed, "missing") is null).
  check.expect(words.starts(trimmed, "FO")).
  check.expect(words.ends(trimmed, "OO")).
  check.expect(words.contains(trimmed, "O")).
  constant parts is words.split("four::four::", "::") try.
  after {
    for each part in parts {
      words.release(part) fallback nothing.
    }
    items.release[text](parts) fallback nothing.
  }
  check.expect(items.length[text](parts) is 3).
  check.same(parts at 0, "four").
  check.same(parts at 2, "").
  files.directory(".artifacts/service") try.
  constant path is files.join(".artifacts/service", "message.txt") try.
  after {
    words.release(path) fallback nothing.
  }
  files.write(path, "FOO" plus newline plus "44") try.
  check.expect(files.exists(path) try).
  constant category is files.kind(path) try.
  after { words.release(category) fallback nothing. }
  check.same(category, "file").
  constant working is files.working try.
  after { words.release(working) fallback nothing. }
  check.expect(words.length(working) is greater than 0).
  constant content is files.read(path) try.
  after {
    words.release(content) fallback nothing.
  }
  check.same(content, "FOO" plus newline plus "44").
  constant file is files.open(path, "read") try.
  check.expect((files.handle(file) try) is (files.handle(file) try)).
  after {
    io.close(file) fallback nothing.
  }
  check.expect((files.position(file) try) is 0).
  check.expect((files.size(file) try) is 6).
  files.seek(file, (0 subtract 2), "end") try.
  check.expect((files.position(file) try) is 4).
  constant tail is io.read(file, 2) try.
  after {
    words.release(tail) fallback nothing.
  }
  check.same(tail, "44").
  files.seek(file, 0, "start") try.
  files.flush(file) try.
  constant line is io.line(file) try.
  after {
    words.release(line) fallback nothing.
  }
  check.same(line, "FOO").
  constant draft is files.join(".artifacts/service", "draft.bin") try.
  constant published is files.join(".artifacts/service", "published.bin") try.
  after {
    words.release(draft) fallback nothing.
    words.release(published) fallback nothing.
  }
  constant output is files.open(draft, "write") try.
  io.write(output, "stable") try.
  files.flush(output) try.
  files.sync(output) try.
  io.close(output) try.
  files.replace(draft, published) try.
  constant stored is files.read(published) try.
  after { words.release(stored) fallback nothing. }
  check.same(stored, "stable").
  constant bytes is files.load(published) try.
  check.expect(items.length[byte](bytes) is 6).
  constant copied is files.join(".artifacts/service", "copied.bin") try.
  after { words.release(copied) fallback nothing. }
  files.copy(published, copied) try.
  files.release(bytes) try.
  constant actual is files.read(copied) try.
  after { words.release(actual) fallback nothing. }
  check.same(actual, "stable").
  files.remove(copied) try.
  check.expect(not (files.exists(copied) try)).
  files.remove(published) try.
  check.same(files.read(published) fallback "removed", "removed").
  constant missing is files.read(".artifacts/service/missing") fallback "missing".
  check.same(missing, "missing").
  check.expect(process.count is greater than 0).
  check.expect((process.run("exit 7") try) is 7).
  constant empty is items.create[text].
  constant flag is items.append[text](empty, "-e") try.
  constant arguments is items.append[text](flag, "process.exit(0)") try.
  after {
    items.release[text](flag) fallback nothing.
    items.release[text](arguments) fallback nothing.
  }
  check.expect((process.execute("node", arguments) try) is 0).
  check.same(process.environment("FOO_MISSING_VARIABLE_7F19") fallback "missing", "missing").
  constant argument is process.argument(0) try.
  after {
    words.release(argument) fallback nothing.
  }
  check.expect(words.length(argument) is greater than 0).
  constant before is clock.current try.
  clock.sleep(1000000) try.
  check.expect((clock.current try) is greater than before).
  constant threads is usage.threads.
  constant task is tasks.spawn(pulse) try.
  check.expect(usage.threads is threads plus 1).
  tasks.wait(task) try.
  check.expect(usage.threads is threads).
  check.expect(count is 1).
  constant executor is jobs.executor try.
  constant scope is jobs.scope try.
  check.expect(jobs.backend greater than or equal to 0).
  check.expect(jobs.launch(scope, accumulate, 2)).
  jobs.join(scope).
  check.expect(count is 3).
  check.expect(jobs.label("foo-test")).
  clock.measure(pulse) try.
  check.expect(count is 4).
  constant mutex is tasks.mutex try.
  constant condition is tasks.condition try.
  tasks.lock(mutex) try.
  tasks.signal(condition) try.
  tasks.unlock(mutex) try.
  tasks.close(mutex) try.
  tasks.close(condition) try.
  constant listener is network.listen("127.0.0.1", 0) try.
  check.expect((network.handle(listener) try) is (network.handle(listener) try)).
  after {
    network.close(listener) fallback nothing.
  }
  constant client is network.connect("127.0.0.1", network.port(listener) try) try.
  after {
    network.close(client) fallback nothing.
  }
  network.latency(client, true) try.
  network.probe(client, true) try.
  constant server is network.accept(listener) try.
  after {
    network.close(server) fallback nothing.
  }
  check.expect((network.push(client, "44") try) is 2).
  network.shutdown(client, "write") try.
  constant received is network.receive(server, 2) try.
  after {
    words.release(received) fallback nothing.
  }
  check.same(received, "44").
  constant loopback is network.ipv4("127.0.0.1") try.
  constant rendered4 is network.numeric4(loopback) try.
  after { words.release(rendered4) fallback nothing. }
  check.same(rendered4, "127.0.0.1").
  constant loopback6 is network.ipv6("::1") try.
  constant rendered6 is network.numeric6(loopback6) try.
  after { words.release(rendered6) fallback nothing. }
  check.same(rendered6, "::1").
  constant resolved is network.resolve("localhost", 1234, "ipv4") try.
  check.same(resolved.host, "127.0.0.1").
  check.expect(resolved.port is 1234).
  words.release(resolved.host) try.
  probe fallback nothing.
  constant adapters is devices.scan try.
  after { devices.close(adapters) fallback nothing. }
  when (devices.count(adapters) try) is greater than 0 {
    check.expect(words.length(devices.name(adapters, 0) try) is greater than 0).
    check.expect(words.length(devices.address(adapters, 0) try) is greater than 0).
    check.expect((devices.mtu(adapters, 0) try) is greater than 0).
  }
  constant routes is paths.scan try.
  after { paths.close(routes) fallback nothing. }
  when (paths.count(routes) try) is greater than 0 {
    check.expect(words.length(paths.destination(routes, 0) try) is greater than 0).
    check.expect((paths.prefix(routes, 0) try) is less than 129).
  }
  constant receiver is network.bind("127.0.0.1", 0) try.
  after { network.dispose(receiver) fallback nothing. }
  constant sender is network.bind("127.0.0.1", 0) try.
  after { network.dispose(sender) fallback nothing. }
  network.broadcast(sender, true) try.
  network.broadcast(sender, false) try.
  constant message is items.sized[byte](3) try.
  after { items.release[byte](message) fallback nothing. }
  set message at 0 to 0.
  set message at 1 to 42.
  set message at 2 to 255.
  constant target is network.address("127.0.0.1", network.local(receiver) try).
  check.expect((network.send4(sender, network.socket4(loopback, target.port), message) try) is 3).
  constant packet is network.capture(receiver, 3) try.
  after { network.discard(packet) fallback nothing. }
  constant payload is network.payload(packet) try.
  check.expect(items.extent[byte](payload) is 3).
  check.expect(payload at 0 is 0).
  check.expect(payload at 1 is 42).
  check.expect(payload at 2 is 255).
  check.same(network.sender(packet) try, "127.0.0.1").
  check.expect((network.origin(packet) try) is (network.local(sender) try)).
  constant typed is network.sender4(packet) try.
  check.expect(typed.ip.bits is loopback.bits).
  check.expect(typed.port is (network.local(sender) try)).
  network.connect4(sender, network.socket4(loopback, target.port)) try.
  check.expect((network.emit(sender, message) try) is 3).
  constant connected is network.capture(receiver, 3) try.
  after { network.discard(connected) fallback nothing. }
  check.expect((network.sender4(connected) try).ip.bits is loopback.bits).
  log.message("services passed") try.
}
