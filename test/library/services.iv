-- Exercises portable files, text, clocks, threads, and TCP connections.
use io as io.
use file as files.
use net as network.
use process as process.
use thread as tasks.
use task as jobs.
use time as clock.
use text as words.
use sequence as items.
use log as log.
use testing as check.
extern "C" function verify giving nothing.
dynamic count of type integer is 0.
function work giving nothing {
  set count to count plus 1.
  give nothing.
}
function scopedwork(value integer) giving nothing for c {
  set count to count plus value.
  give nothing.
}
start {
  constant joined is words.concatenate("FO", "O") try.
  constant trimmed is words.trim("  FOO  ") try.
  after {
    words.release(joined) fallback nothing.
    words.release(trimmed) fallback nothing.
  }
  check.same(joined, trimmed).
  check.expect(words.find(trimmed, "OO") is not null).
  check.expect(words.find(trimmed, "missing") is null).
  check.expect(words.starts(trimmed, "FO")).
  check.expect(words.ends(trimmed, "OO")).
  check.expect(words.contains(trimmed, "O")).
  constant parts is words.split("four::four::", "::") try.
  after {
    for each part in parts {
      words.release(part) fallback nothing.
    }
    items.release[text](parts) fallback nothing.
  }
  check.expect(items.length[text](parts) is 3).
  check.same(parts at 0, "four").
  check.same(parts at 2, "").
  files.directory(".artifacts/service") try.
  constant path is files.join(".artifacts/service", "message.txt") try.
  after {
    words.release(path) fallback nothing.
  }
  files.write(path, "FOO" plus newline plus "44") try.
  check.expect(files.exists(path) try).
  constant filekind is files.kind(path) try.
  after { words.release(filekind) fallback nothing. }
  check.same(filekind, "file").
  constant working is files.working try.
  after { words.release(working) fallback nothing. }
  check.expect(words.length(working) is greater than 0).
  constant content is files.read(path) try.
  after {
    words.release(content) fallback nothing.
  }
  check.same(content, "FOO" plus newline plus "44").
  constant file is files.open(path, "read") try.
  check.expect((files.handle(file) try) is (files.handle(file) try)).
  after {
    io.close(file) fallback nothing.
  }
  check.expect((files.position(file) try) is 0).
  check.expect((files.size(file) try) is 6).
  files.seek(file, (0 subtract 2), "end") try.
  check.expect((files.position(file) try) is 4).
  constant tail is io.read(file, 2) try.
  after {
    words.release(tail) fallback nothing.
  }
  check.same(tail, "44").
  files.seek(file, 0, "start") try.
  files.flush(file) try.
  constant line is io.line(file) try.
  after {
    words.release(line) fallback nothing.
  }
  check.same(line, "FOO").
  constant draft is files.join(".artifacts/service", "draft.bin") try.
  constant published is files.join(".artifacts/service", "published.bin") try.
  after {
    words.release(draft) fallback nothing.
    words.release(published) fallback nothing.
  }
  constant output is files.open(draft, "write") try.
  io.write(output, "stable") try.
  files.flush(output) try.
  files.sync(output) try.
  io.close(output) try.
  files.replace(draft, published) try.
  constant stored is files.read(published) try.
  after { words.release(stored) fallback nothing. }
  check.same(stored, "stable").
  constant bytes is files.readbytes(published) try.
  check.expect(items.length[byte](bytes) is 6).
  constant copied is files.join(".artifacts/service", "copied.bin") try.
  after { words.release(copied) fallback nothing. }
  files.copy(published, copied) try.
  files.releasebytes(bytes) try.
  constant copiedtext is files.read(copied) try.
  after { words.release(copiedtext) fallback nothing. }
  check.same(copiedtext, "stable").
  files.remove(copied) try.
  check.expect(not (files.exists(copied) try)).
  files.remove(published) try.
  check.same(files.read(published) fallback "removed", "removed").
  constant missing is files.read(".artifacts/service/missing") fallback "missing".
  check.same(missing, "missing").
  check.expect(process.count is greater than 0).
  check.expect((process.run("exit 7") try) is 7).
  constant noarguments is items.create[text].
  constant firstargument is items.append[text](noarguments, "-e") try.
  constant arguments is items.append[text](firstargument, "process.exit(0)") try.
  after {
    items.release[text](firstargument) fallback nothing.
    items.release[text](arguments) fallback nothing.
  }
  check.expect((process.execute("node", arguments) try) is 0).
  check.same(process.environment("FOO_MISSING_VARIABLE_7F19") fallback "missing", "missing").
  constant argument is process.argument(0) try.
  after {
    words.release(argument) fallback nothing.
  }
  check.expect(words.length(argument) is greater than 0).
  constant before is clock.current try.
  clock.sleep(1000000) try.
  check.expect((clock.current try) is greater than before).
  constant task is tasks.spawn(work) try.
  tasks.wait(task) try.
  check.expect(count is 1).
  constant executor is jobs.executor try.
  constant scope is jobs.scope try.
  check.expect(jobs.backend greater than or equal to 0).
  check.expect(jobs.launch(scope, scopedwork, 2)).
  jobs.join(scope).
  check.expect(count is 3).
  check.expect(jobs.label("foo-test")).
  clock.measure(work) try.
  check.expect(count is 4).
  constant mutex is tasks.mutex try.
  constant condition is tasks.condition try.
  tasks.lock(mutex) try.
  tasks.signal(condition) try.
  tasks.unlock(mutex) try.
  tasks.close(mutex) try.
  tasks.close(condition) try.
  constant listener is network.listen("127.0.0.1", 0) try.
  check.expect((network.handle(listener) try) is (network.handle(listener) try)).
  after {
    network.close(listener) fallback nothing.
  }
  constant client is network.connect("127.0.0.1", network.port(listener) try) try.
  after {
    network.close(client) fallback nothing.
  }
  network.nodelay(client, true) try.
  network.keepalive(client, true) try.
  constant server is network.accept(listener) try.
  after {
    network.close(server) fallback nothing.
  }
  check.expect((network.push(client, "44") try) is 2).
  network.shutdown(client, "write") try.
  constant received is network.receive(server, 2) try.
  after {
    words.release(received) fallback nothing.
  }
  check.same(received, "44").
  log.message("services passed") try.
  verify.
}
