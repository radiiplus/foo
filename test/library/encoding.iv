use codec as codecs.
use sequence as sequences.
use testing as check.
use text as words.
define Point as record {
  x of type integer 32.
  y of type integer 32.
  active of type boolean.
}.
define Samples as record {
  values of type sequence of integer.
}.
define Maybe as record {
  value of type optional integer.
}.
define Selection as choice {
  chosen(integer).
  missing.
}.
define Narrow as record {
  value of type integer 7.
}.
define Wide as record {
  value of type unsigned 100.
}.
define Root as record {
  metadata of type sequence of byte.
  integrity of type sequence of byte.
}.
define Label as record {
  value of type text.
}.
define Entry as choice {
  saved(Root).
  absent.
}.
function advance(value unsigned 100) giving unsigned 100 {
  give value plus 1.
}
test "typed codec" {
  constant encoded is codecs.encode[Point](Point(4, 0 subtract 2, true)) fallback "failed".
  after {
    words.release(encoded) fallback nothing.
  }
  check.same(encoded, "{\"x\":4,\"y\":-2,\"active\":true}").
  constant decoded is codecs.decode[Point](encoded) fallback Point(0, 0, false).
  check.expect(decoded.x is 4 and decoded.y is (0 subtract 2) and decoded.active).

  constant empty is sequences.create[integer].
  constant first is sequences.append[integer](empty, 4) try.
  constant values is sequences.append[integer](first, 9) try.
  after {
    sequences.release[integer](first) fallback nothing.
    sequences.release[integer](values) fallback nothing.
  }
  constant packet is codecs.encode[Samples](Samples(values)) fallback "failed".
  after {
    words.release(packet) fallback nothing.
  }
  check.same(packet, "{\"values\":[4,9]}").
  constant unpacked is codecs.decode[Samples](packet) fallback Samples(empty).
  constant actual is unpacked.values.
  check.expect(sequences.length[integer](actual) is 2).
  check.expect(actual at 0 is 4 and actual at 1 is 9).

  constant present is codecs.encode[Maybe](Maybe(7)) fallback "failed".
  after {
    words.release(present) fallback nothing.
  }
  check.same(present, "{\"value\":7}").
  constant restored is codecs.decode[Maybe](present) fallback Maybe(null).
  check.expect(restored.value is 7 and 7 is restored.value).
  check.expect(8 is not restored.value).
  check.expect(restored.value is greater than 6).
  constant absent is codecs.encode[Maybe](Maybe(null)) fallback "failed".
  after {
    words.release(absent) fallback nothing.
  }
  check.same(absent, "{\"value\":null}").

  constant selection is codecs.encode[Selection](chosen(5)) fallback "failed".
  after {
    words.release(selection) fallback nothing.
  }
  check.same(selection, "{\"chosen\":5}").
  constant selected is codecs.decode[Selection](selection) fallback missing.
  match selected {
    case chosen(value) {
      check.expect(value is 5).
    }
    case missing {
      check.expect(false).
    }
  }
  constant vacant is codecs.encode[Selection](missing) fallback "failed".
  after {
    words.release(vacant) fallback nothing.
  }
  check.same(vacant, "{\"missing\":{}}").
  constant unknown is codecs.decode[Selection]("{\"unknown\":1}") fallback missing.
  match unknown {
    case chosen(value) {
      check.expect(false).
    }
    case missing {
      check.expect(true).
    }
  }

  constant narrow is codecs.encode[Narrow](Narrow(63)) fallback "failed".
  after {
    words.release(narrow) fallback nothing.
  }
  check.same(narrow, "{\"value\":63}").
  constant small is codecs.decode[Narrow](narrow) fallback Narrow(0).
  check.expect(small.value is 63).
  constant huge of type unsigned 100 is 18446744073709551616.
  check.expect(advance(huge) is greater than huge).
  constant wide is codecs.encode[Wide](Wide(huge)) fallback "failed".
  after {
    words.release(wide) fallback nothing.
  }
  check.same(wide, "{\"value\":18446744073709551616}").
  constant large is codecs.decode[Wide](wide) fallback Wide(0).
  check.expect(large.value is huge).
  constant label is codecs.encode[Label](Label("hello")) fallback "failed".
  after {
    words.release(label) fallback nothing.
  }
  check.same(label, "{\"value\":\"hello\"}").
}

test "byte codec" {
  constant bytes is sequences.create[byte].
  constant data is sequences.append[byte](bytes, 65) try.
  after {
    sequences.release[byte](data) fallback nothing.
  }
  constant root is Root(bytes, data).
  constant encoded is codecs.encode[Root](root) fallback "failed".
  after {
    words.release(encoded) fallback nothing.
  }
  check.same(encoded, "{\"metadata\":[],\"integrity\":[65]}").
}

test "byte decoding" {
  constant bytes is sequences.create[byte].
  constant decoded is codecs.decode[Root]("{\"metadata\":[],\"integrity\":[65]}") fallback Root(bytes, bytes).
  check.expect(sequences.length[byte](decoded.metadata) is 0).
  check.expect(sequences.length[byte](decoded.integrity) is 1).
  check.expect(decoded.integrity at 0 is 65).
}

test "nested byte codec" {
  constant bytes is sequences.create[byte].
  constant data is sequences.append[byte](bytes, 65) try.
  after {
    sequences.release[byte](data) fallback nothing.
  }
  constant root is Root(bytes, data).
  constant manifest is codecs.encode[Entry](saved(root)) fallback "failed".
  after {
    words.release(manifest) fallback nothing.
  }
  check.same(manifest, "{\"saved\":{\"metadata\":[],\"integrity\":[65]}}").
  constant parsed is codecs.decode[Entry](manifest) fallback absent.
  match parsed {
    case saved(item) {
      check.expect(sequences.length[byte](item.metadata) is 0).
      check.expect(item.integrity at 0 is 65).
    }
    case absent {
      check.expect(false).
    }
  }
}
