-- Checks allocation contents, resizing, ownership and arena cleanup.
use "../../lib/memory.iv".
use arch as machine.
use testing as check.
function drop(owner pointer to allocator, buffer pointer to byte) giving failable text {
  release(owner, buffer) try.
  give "released".
}
start {
  check.expect(machine.count(255) is 8).
  machine.pause.
  check.expect(machine.ticks greater than 0).
  constant allocator is system.
  constant buffer is allocate(allocator, 4) try.
  check.expect(identical[byte](buffer, buffer)).
  check.same(view(allocator, buffer, 4) try, "\0\0\0\0").
  copy(allocator, buffer, "FOO!") try.
  constant grown is expand(allocator, buffer, 8) try.
  check.same(view(allocator, grown, 8) try, "FOO!\0\0\0\0").
  constant smaller is expand(allocator, grown, 2) try.
  check.same(view(allocator, smaller, 2) try, "FO").
  constant binary is bytes(allocator, smaller, 2) try.
  check.expect(binary at 0 is 70).
  check.expect(binary at 1 is 79).
  check.same(view(allocator, smaller, 3) fallback "bounds", "bounds").
  constant unchanged is expand(allocator, smaller, 18446744073709551615) fallback smaller.
  check.same(view(allocator, unchanged, 2) try, "FO").
  constant group is arena try.
  check.same(view(group, smaller, 2) fallback "owner", "owner").
  check.same(drop(group, smaller) fallback "owner", "owner").
  check.same(view(allocator, smaller, 2) try, "FO").
  constant temporary is allocate(group, 8) try.
  copy(group, temporary, "arena") try.
  close(group) try.
  check.same(view(group, temporary, 5) fallback "closed", "closed").
  release(allocator, smaller) try.
  check.same(drop(allocator, smaller) fallback "stale", "stale").
  check.same(view(allocator, smaller, 0) fallback "released", "released").
  constant empty is allocate(allocator, 0) try.
  check.same(view(allocator, empty, 0) try, "").
  release(allocator, empty) try.
  give nothing.
}
