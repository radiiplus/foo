-- Writes a serial marker on the AArch64 virtual board without a runtime.
define Device as record {
  data of type pointer to unsigned 32 with exact access.
}.

function boot for startup without setup {
  native asm { "mov x0, #0x09000000; mov w1, #65; strb w1, [x0]; 1: wfe; b 1b" }
  give nothing.
}
