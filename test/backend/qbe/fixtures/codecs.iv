use testing as check.
use codec as codecs.
use "text" function release(content text) giving failable nothing.
define Packet as record { x of type integer 32. active of type boolean. value of type optional integer. }.
start {
  constant encoded is codecs.encode[Packet](Packet(4, true, 7)) fallback "failed".
  check.same(encoded, "{\"x\":4,\"active\":true,\"value\":7}").
  display encoded.
  constant decoded is codecs.decode[Packet](encoded) fallback Packet(0, false, null).
  check.expect(decoded.x is 4 and decoded.active and decoded.value is 7).
  release(encoded) fallback nothing.
  display "\n".
}
