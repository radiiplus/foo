use codec as codecs.
use "text" function release(content text) giving failable nothing.
use testing as check.
define Pair as record { value of type integer 9. }.
use "codec" function encode(value Pair) giving failable text.
function pack(value Pair) giving failable text keeping call { give codecs.encode[Pair](value) try. }
function unpack(source text) giving failable Pair keeping call { give codecs.decode[Pair](source) try. }
start {
  constant adapter is encode.
  constant original is adapter(Pair(17)) try.
  after { release(original) fallback nothing. }
  check.same(original,"{\"value\":17}").
  constant serializer of type codecs.codec[Pair] is codecs.codec[Pair](pack,unpack).
  constant encoded is serializer.encode(Pair(42)) try.
  after { release(encoded) fallback nothing. }
  check.same(encoded,"{\"value\":42}").
  constant decoded is serializer.decode(encoded) try.
  check.expect(decoded.value is 42).
  display encoded.
  display "\n".
}
