use "../../../../lib/atomic.iv" as atoms.
use testing as check.

start {
  constant value is atoms.create(7) try.
  after { atoms.release(value). }
  check.expect(atoms.attempt(value, 7, 11, "both") try).
  check.expect((atoms.deduct(value, 3, "release") try) is 11).
  check.expect(atoms.load(value, "acquire") try is 8).
  check.expect(not (atoms.attempt(value, 7, 12, "sequential") try)).
  check.expect(atoms.compare(value, 8, 9, "release", "relaxed") try).
  check.expect(not (atoms.compare(value, 8, 10, "acquire", "acquire") try)).
  check.expect(atoms.load(value, "acquire") try is 9).
  check.expect((atoms.load(value, "release") fallback 99) is 99).
  check.expect((atoms.add(value, 1, "unknown") fallback 99) is 99).
  check.expect(not (atoms.compare(value, 9, 10, "release", "acquire") fallback false)).
  atoms.store(value, 99, "acquire") fallback nothing.
  check.expect(atoms.load(value, "acquire") try is 9).
  atoms.store(value, 15, "release") try.
  check.expect((atoms.add(value, 3, "both") try) is 15).
  check.expect((atoms.swap(value, 9, "sequential") try) is 18).
  check.expect(atoms.replace(value, 9, 10, "acquire") try).
  check.expect(atoms.compare(value, 10, 11, "release", "relaxed") try).
  check.expect((atoms.read(value, atoms.acquire) try) is 11).
}
