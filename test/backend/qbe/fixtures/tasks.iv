use task as jobs.
use thread as threads.
use resource as usage.
use testing as check.

dynamic count of type integer is 0.

function pulse giving nothing {
  set count to count plus 1.
}

function work(value integer) giving nothing for c {
  set count to count plus value.
}

start {
  constant thread is threads.spawn(pulse) try.
  threads.wait(thread) try.
  check.expect(count is 1).

  constant scope is jobs.scope try.
  check.expect(jobs.launch(scope, work, 2)).
  jobs.join(scope).
  check.expect(count is 3).

  constant pool is jobs.pool try.
  check.expect(jobs.submit(pool, work, 4)).
  jobs.wait(pool).
  check.expect(count is 7).
  check.expect(usage.tasks is 0).
  check.expect(usage.pending is 0).

  constant mutex is threads.mutex try.
  constant condition is threads.condition try.
  threads.lock(mutex) try.
  threads.signal(condition) try.
  threads.unlock(mutex) try.
  threads.close(mutex) try.
  threads.close(condition) try.
}
