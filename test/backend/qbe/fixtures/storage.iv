use testing as check.
dynamic message of type text is "hello\0world".
dynamic selected of type optional integer 32 is 7.
dynamic empty of type optional integer 32 is null.
dynamic flag of type boolean is false.
dynamic wide of type unsigned 128 is 340282366920938463463374607431768211455.
function update {
  set message to "updated".
  set selected to 42.
  set flag to true.
}
start {
  constant large is reflect[unsigned 128].
  constant small is reflect[integer 9].
  check.expect(large.size is 16 and large.alignment is 16).
  check.expect(small.size is 2 and small.alignment is 2).
  check.expect(reflect[unsigned 128].size is 16 and reflect[integer 9].alignment is 2).
  check.same(message,"hello\0world").
  check.expect(selected is 7 and empty is null and not flag).
  check.expect(wide is 340282366920938463463374607431768211455).
  update.
  check.same(message,"updated").
  check.expect(selected is 42 and flag).
}
