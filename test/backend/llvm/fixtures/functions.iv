use sequence as items.
use testing as check.
define Pair as record { left of type integer 9. right of type unsigned 65. }.
function increment(value Pair) giving Pair keeping call {
  give Pair(value.left plus 1,value.right).
}
function apply(value Pair,operation function taking (Pair) giving Pair) giving Pair keeping call {
  give operation(value).
}
start {
  constant operation is increment.
  constant value is apply(Pair(4,18446744073709551616),operation).
  check.expect(value.left is 5 and value.right is 18446744073709551616).
  constant source is items.sized[Pair](2) try.
  after { items.release[Pair](source) fallback nothing. }
  set source at 0 to Pair(4,9).
  set source at 1 to Pair(7,11).
  constant transformed is items.map[Pair,Pair](source,operation) try.
  after { items.release[Pair](transformed) fallback nothing. }
  check.expect((transformed at 0).left is 5 and (transformed at 1).left is 8).
  check.expect((source at 0).left is 4 and (source at 1).left is 7).
}
