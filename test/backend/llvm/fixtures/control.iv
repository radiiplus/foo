use testing as check.
function twice[T](value T) giving T { give value plus value. }
function choose(flag boolean) giving integer {
  if flag { give twice[integer](21). }
  give 7.
}
function increment(value integer) giving integer { give value plus 1. }
start {
  dynamic total is 0.
  dynamic index is 0.
  while index less than 6 {
    set total to total plus index.
    set index to increment(index).
  }
  check.expect(total is 15).
  check.expect(choose(true) is 42 and choose(false) is 7).
  check.expect(false or true and not false).
  constant apply is increment.
  check.expect(apply(41) is 42).
}
