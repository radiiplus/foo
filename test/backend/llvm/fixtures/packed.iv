use testing as check.
define Bits as packed record { low of type unsigned 3. enabled of type boolean. signed of type integer 5. }.
define Packet as packed record { prefix of type byte. bits of type Bits. suffix of type unsigned 7. }.
start {
  constant bits is Bits(5, true, 0 subtract 3).
  check.expect(bits.low is 5 and bits.enabled and bits.signed is (0 subtract 3)).
  constant packet is Packet(42, bits, 77).
  check.expect(packet.prefix is 42 and packet.bits.low is 5 and packet.suffix is 77).
}
