use testing as check.
define Pair as record { left of type integer 9. right of type unsigned 65. } derives Equatable, Ord.
define Box[T] as record { value of type T. } derives Equatable, Ord.
define Item as choice { pair(Pair). word(text). empty. }.
function identity[T](value T) giving T { give value. }
function choose(flag boolean) giving Item {
  constant low of type integer 9 is 0 subtract 255 subtract 1.
  when flag { give pair(Pair(low,18446744073709551616)). }
  give empty.
}
start {
  constant low of type integer 9 is 0 subtract 255 subtract 1.
  constant value is Box[Pair](identity[Pair](Pair(low,18446744073709551616))).
  check.expect(value is Box[Pair](Pair(low,18446744073709551616))).
  check.expect(value is less than Box[Pair](Pair(low plus 1,0))).
  constant some of type optional Pair is value.value.
  constant none of type optional Pair is null.
  check.expect(some is Pair(low,18446744073709551616) and none is null).
  check.expect(none is less than some).
  check.expect(choose(false) is empty).
  check.expect(choose(true) is pair(value.value)).
  match choose(true) {
    case pair(payload) { check.expect(payload.left is low). }
    case word(payload) { check.expect(false). }
    case empty { check.expect(false). }
  }
}
