use codec as codecs.
use text as words.
use testing as check.
define Value as choice { number(integer 128). empty. }.
start {
  constant wide is codecs.encode[unsigned 128](340282366920938463463374607431768211455) try.
  after { words.release(wide) fallback nothing. }
  check.same(wide,"340282366920938463463374607431768211455").
  check.expect((codecs.decode[unsigned 128](wide) try) is 340282366920938463463374607431768211455).
  display wide.
  constant selected of type Value is number(170141183460469231731687303715884105727).
  constant encoded is codecs.encode[Value](selected) try.
  after { words.release(encoded) fallback nothing. }
  check.same(encoded,"{\"number\":170141183460469231731687303715884105727}").
  check.expect((codecs.decode[Value](encoded) try) is selected).
  display encoded.
  constant emptyValue of type Value is empty.
  constant emptyText is codecs.encode[Value](emptyValue) try.
  after { words.release(emptyText) fallback nothing. }
  check.same(emptyText,"{\"empty\":{}}").
  check.expect((codecs.decode[Value](emptyText) try) is empty).
  display emptyText.
  constant byteText is codecs.encode[byte](255) try.
  after { words.release(byteText) fallback nothing. }
  check.same(byteText,"255").
  check.expect((codecs.decode[byte](byteText) try) is 255).
  display byteText.
  constant booleanText is codecs.encode[boolean](false) try.
  after { words.release(booleanText) fallback nothing. }
  check.same(booleanText,"false").
  check.expect(not (codecs.decode[boolean](booleanText) try)).
  display booleanText.
}
