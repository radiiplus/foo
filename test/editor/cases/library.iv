-- Source: lib/sequence.iv
-- Builds typed sequences and applies ordering, searching, and transformations.
public use "sequence" function create[T] giving sequence of T.
public use "sequence" function append[T](items sequence of T, value T) giving failable sequence of T.
public use "sequence" function remove[T](items sequence of T, index unsigned) giving failable sequence of T.
public use "sequence" function copy[T](items sequence of T) giving failable sequence of T.
public use "sequence" function length[T](items sequence of T) giving unsigned.
-- Reads the length of a borrowed, read-only sequence without copying it.
public use "sequence" function extent[T](items sequence of constant T) giving unsigned.
-- The returned view borrows items; keep the owner alive while using it.
public use "sequence" function view[T](items sequence of constant T, offset unsigned, count unsigned) giving failable sequence of constant T.
public use "sequence" function release[T](items sequence of T) giving failable nothing.
public use "sequence" function sized[T](length unsigned) giving failable sequence of T.
use "sequence" function compact[T](items sequence of T, length unsigned) giving failable sequence of T.
public function find[T](items sequence of T, value T) giving optional unsigned where T is Equatable {
  dynamic index of type unsigned is 0.
  for each item in items {
    when item is value {
      give index.
    }
    set index to index plus 1.
  }
  give null.
}
-- These operations require values sorted in ascending order under Ord.
public function lower[T](values sequence of constant T, target T) giving unsigned where T is Ord {
  dynamic left of type unsigned is 0.
  dynamic right is extent[T](values).
  while left less than right {
    constant middle is left plus (right subtract left) divide 2.
    when (values at middle) less than target {
      set left to middle plus 1.
    } otherwise {
      set right to middle.
    }
  }
  give left.
}
public function upper[T](values sequence of constant T, target T) giving unsigned where T is Ord {
  dynamic left of type unsigned is 0.
  dynamic right is extent[T](values).
  while left less than right {
    constant middle is left plus (right subtract left) divide 2.
    when target less than (values at middle) {
      set right to middle.
    } otherwise {
      set left to middle plus 1.
    }
  }
  give left.
}
public function search[T](values sequence of constant T, target T) giving optional unsigned where T is Ord {
  constant index is lower[T](values, target).
  when index less than extent[T](values) and (values at index) is target {
    give index.
  }
  give null.
}
-- Removes adjacent duplicates from ascending input into independent storage.
public function unique[T](values sequence of constant T) giving failable sequence of T where T is Ord {
  constant length is extent[T](values).
  constant result is sized[T](length) try.
  after error { release[T](result) fallback nothing. }
  dynamic count of type unsigned is 0.
  for each value in values {
    when count is 0 or not ((result at (count subtract 1)) is value) {
      set result at count to value.
      increase count by 1.
    }
  }
  give compact[T](result, count) try.
}
-- Merges two ascending inputs into one independently owned stable result.
public function merge[T](left sequence of constant T, right sequence of constant T) giving failable sequence of T where T is Ord {
  constant first is extent[T](left).
  constant second is extent[T](right).
  when second greater than 18446744073709551615 subtract first {
    give fail(Error.Bounds).
  }
  constant result is sized[T](first plus second) try.
  dynamic a of type unsigned is 0.
  dynamic b of type unsigned is 0.
  dynamic cursor of type unsigned is 0.
  while a less than first and b less than second {
    when (right at b) less than (left at a) {
      set result at cursor to right at b.
      increase b by 1.
    } otherwise {
      set result at cursor to left at a.
      increase a by 1.
    }
    increase cursor by 1.
  }
  while a less than first {
    set result at cursor to left at a.
    increase a by 1.
    increase cursor by 1.
  }
  while b less than second {
    set result at cursor to right at b.
    increase b by 1.
    increase cursor by 1.
  }
  give result.
}
-- Advances past every copy of the current value in an ascending sequence.
function advance[T](values sequence of constant T, index unsigned) giving unsigned where T is Ord {
  constant value is values at index.
  dynamic cursor is index plus 1.
  while cursor less than extent[T](values) and (values at cursor) is value {
    increase cursor by 1.
  }
  give cursor.
}
-- Returns the ascending union of two ascending sequences without duplicates.
public function unite[T](left sequence of constant T, right sequence of constant T) giving failable sequence of T where T is Ord {
  constant first is extent[T](left).
  constant second is extent[T](right).
  when second greater than 18446744073709551615 subtract first {
    give fail(Error.Bounds).
  }
  constant result is sized[T](first plus second) try.
  after error { release[T](result) fallback nothing. }
  dynamic a of type unsigned is 0.
  dynamic b of type unsigned is 0.
  dynamic count of type unsigned is 0.
  while a less than first and b less than second {
    when (left at a) less than (right at b) {
      set result at count to left at a.
      set a to advance[T](left, a).
    } otherwise when (right at b) less than (left at a) {
      set result at count to right at b.
      set b to advance[T](right, b).
    } otherwise {
      set result at count to left at a.
      set a to advance[T](left, a).
      set b to advance[T](right, b).
    }
    increase count by 1.
  }
  while a less than first {
    set result at count to left at a.
    increase count by 1.
    set a to advance[T](left, a).
  }
  while b less than second {
    set result at count to right at b.
    increase count by 1.
    set b to advance[T](right, b).
  }
  give compact[T](result, count) try.
}
-- Returns the ascending values shared by two ascending sequences.
public function intersect[T](left sequence of constant T, right sequence of constant T) giving failable sequence of T where T is Ord {
  constant first is extent[T](left).
  constant second is extent[T](right).
  dynamic capacity is first.
  when second less than first { set capacity to second. }
  constant result is sized[T](capacity) try.
  after error { release[T](result) fallback nothing. }
  dynamic a of type unsigned is 0.
  dynamic b of type unsigned is 0.
  dynamic count of type unsigned is 0.
  while a less than first and b less than second {
    when (left at a) less than (right at b) {
      set a to advance[T](left, a).
    } otherwise when (right at b) less than (left at a) {
      set b to advance[T](right, b).
    } otherwise {
      set result at count to left at a.
      increase count by 1.
      set a to advance[T](left, a).
      set b to advance[T](right, b).
    }
  }
  give compact[T](result, count) try.
}
-- Returns ascending values from left that do not appear in right.
public function difference[T](left sequence of constant T, right sequence of constant T) giving failable sequence of T where T is Ord {
  constant first is extent[T](left).
  constant second is extent[T](right).
  constant result is sized[T](first) try.
  after error { release[T](result) fallback nothing. }
  dynamic a of type unsigned is 0.
  dynamic b of type unsigned is 0.
  dynamic count of type unsigned is 0.
  while a less than first and b less than second {
    when (left at a) less than (right at b) {
      set result at count to left at a.
      increase count by 1.
      set a to advance[T](left, a).
    } otherwise when (right at b) less than (left at a) {
      set b to advance[T](right, b).
    } otherwise {
      set a to advance[T](left, a).
      set b to advance[T](right, b).
    }
  }
  while a less than first {
    set result at count to left at a.
    increase count by 1.
    set a to advance[T](left, a).
  }
  give compact[T](result, count) try.
}
public function sort[T](items sequence of T) giving failable sequence of T where T is Ord {
  dynamic result is copy[T](items) try.
  after error { release[T](result) fallback nothing. }
  constant size is length[T](result).
  when size less than 2 { give result. }
  constant scratch is sized[T](size) try.
  after { release[T](scratch) fallback nothing. }
  dynamic width of type unsigned is 1.
  while width less than size {
    dynamic origin of type unsigned is 0.
    while origin less than size {
      dynamic middle is size.
      when width less than size subtract origin { set middle to origin plus width. }
      dynamic end is size.
      when width less than size subtract middle { set end to middle plus width. }
      dynamic left is origin.
      dynamic right is middle.
      dynamic cursor is origin.
      while left less than middle and right less than end {
        when (result at right) less than (result at left) {
          set scratch at cursor to result at right.
          increase right by 1.
        } otherwise {
          set scratch at cursor to result at left.
          increase left by 1.
        }
        increase cursor by 1.
      }
      while left less than middle {
        set scratch at cursor to result at left.
        increase left by 1.
        increase cursor by 1.
      }
      while right less than end {
        set scratch at cursor to result at right.
        increase right by 1.
        increase cursor by 1.
      }
      set origin to end.
    }
    dynamic index of type unsigned is 0.
    while index less than size {
      set result at index to scratch at index.
      increase index by 1.
    }
    when width greater than size divide 2 { set width to size. }
    otherwise { set width to width multiply 2. }
  }
  give result.
}
public function filter[T](items sequence of T, predicate function taking (T) giving boolean) giving failable sequence of T {
  dynamic result is sized[T](length[T](items)) try.
  after error {
    release[T](result) fallback nothing.
  }
  dynamic count of type unsigned is 0.
  for each item in items {
    when predicate(item) {
      set result at count to item.
      set count to count plus 1.
    }
  }
  give compact[T](result, count) try.
}
public define division[T] as record {
  kept of type sequence of T.
  rest of type sequence of T.
}.
-- Evaluates the predicate once per item and preserves order in each result.
public function partition[T](items sequence of T, predicate function taking (T) giving boolean) giving failable division[T] {
  constant size is length[T](items).
  constant flags is sized[boolean](size) try.
  after { release[boolean](flags) fallback nothing. }
  dynamic count of type unsigned is 0.
  dynamic index of type unsigned is 0.
  while index less than size {
    constant selected is predicate(items at index).
    set flags at index to selected.
    when selected { increase count by 1. }
    increase index by 1.
  }
  constant kept is sized[T](count) try.
  after error { release[T](kept) fallback nothing. }
  constant rest is sized[T](size subtract count) try.
  after error { release[T](rest) fallback nothing. }
  dynamic yes of type unsigned is 0.
  dynamic no of type unsigned is 0.
  set index to 0.
  while index less than size {
    when flags at index {
      set kept at yes to items at index.
      increase yes by 1.
    } otherwise {
      set rest at no to items at index.
      increase no by 1.
    }
    increase index by 1.
  }
  give division[T](kept, rest).
}
public function map[T, U](items sequence of T, transform function taking (T) giving U) giving failable sequence of U {
  dynamic result is sized[U](length[T](items)) try.
  after error {
    release[U](result) fallback nothing.
  }
  dynamic index is 0.
  for each item in items {
    set result at index to transform(item).
    set index to index plus 1.
  }
  give result.
}
public function reverse[T](items sequence of T) giving failable sequence of T {
  constant count is length[T](items).
  dynamic result is sized[T](count) try.
  after error { release[T](result) fallback nothing. }
  dynamic index of type unsigned is 0.
  while index less than count {
    set result at index to items at (count subtract index subtract 1).
    increase index by 1.
  }
  give result.
}
public function any[T](items sequence of T, predicate function taking (T) giving boolean) giving boolean {
  for each item in items {
    when predicate(item) { give true. }
  }
  give false.
}
public function all[T](items sequence of T, predicate function taking (T) giving boolean) giving boolean {
  for each item in items {
    when not predicate(item) { give false. }
  }
  give true.
}
public function fold[T, U](items sequence of T, initial U, combine function taking (U, T) giving U) giving U {
  dynamic result is initial.
  for each item in items {
    set result to combine(result, item).
  }
  give result.
}
public function take[T](items sequence of T, count unsigned) giving failable sequence of T {
  when count greater than length[T](items) { give fail(Error.Bounds). }
  dynamic result is sized[T](count) try.
  after error { release[T](result) fallback nothing. }
  dynamic index of type unsigned is 0.
  while index less than count {
    set result at index to items at index.
    increase index by 1.
  }
  give result.
}
public function drop[T](items sequence of T, count unsigned) giving failable sequence of T {
  when count greater than length[T](items) { give fail(Error.Bounds). }
  constant remaining is length[T](items) subtract count.
  dynamic result is sized[T](remaining) try.
  after error { release[T](result) fallback nothing. }
  dynamic index of type unsigned is 0.
  while index less than remaining {
    set result at index to items at (count plus index).
    increase index by 1.
  }
  give result.
}
public function deduplicate[T](items sequence of T) giving failable sequence of T where T is Equatable {
  dynamic result is sized[T](length[T](items)) try.
  after error {
    release[T](result) fallback nothing.
  }
  dynamic count of type unsigned is 0.
  for each item in items {
    dynamic present is false.
    dynamic cursor of type unsigned is 0.
    while cursor less than count {
      when result at cursor is item {
        set present to true.
        stop.
      }
      set cursor to cursor plus 1.
    }
    when not present {
      set result at count to item.
      set count to count plus 1.
    }
  }
  give compact[T](result, count) try.
}
public function dedup[T](items sequence of T) giving failable sequence of T where T is Equatable {
  give deduplicate[T](items) try.
}

-- Source: lib/text.iv
-- Combines, trims, and splits text using byte offsets and ASCII whitespace.
use sequence as items.
use "sequence" function sized[T](length unsigned) giving failable sequence of T.
public use "text" function concatenate(left text, right text) giving failable text.
public use "text" function trim(content text) giving failable text.
public use "text" function length(content text) giving unsigned.
public use "text" function slice(content text, first unsigned, last unsigned) giving failable text.
public use "text" function find(content text, value text) giving optional unsigned.
public use "text" function release(content text) giving failable nothing.
public function starts(content text, prefix text) giving boolean {
  when length(prefix) greater than length(content) {
    give false.
  }
  dynamic index of type unsigned is 0.
  while index less than length(prefix) {
    when content at index is not prefix at index {
      give false.
    }
    increase index by 1.
  }
  give true.
}
public function ends(content text, suffix text) giving boolean {
  constant size is length(content).
  constant span is length(suffix).
  when span greater than size {
    give false.
  }
  dynamic index of type unsigned is 0.
  while index less than span {
    when content at (size subtract span plus index) is not suffix at index {
      give false.
    }
    increase index by 1.
  }
  give true.
}
public function contains(content text, value text) giving boolean {
  give find(content, value) is not null.
}
public function split(content text, separator text) giving failable sequence of text {
  constant width is length(separator).
  constant size is length(content).
  when width is 0 {
    give fail(Error.Separator).
  }
  dynamic count of type unsigned is 1.
  dynamic cursor of type unsigned is 0.
  while cursor plus width less than or equal to size {
    dynamic matches is true.
    dynamic index of type unsigned is 0.
    while index less than width {
      when content at (cursor plus index) is not separator at index {
        set matches to false.
        stop.
      }
      set index to index plus 1.
    }
    when matches {
      set count to count plus 1.
      set cursor to cursor plus width.
    } otherwise {
      set cursor to cursor plus 1.
    }
  }
  dynamic result is sized[text](count) try.
  after error {
    for each part in result {
      release(part) fallback nothing.
    }
    items.release[text](result) fallback nothing.
  }
  dynamic first of type unsigned is 0.
  set cursor to 0.
  dynamic position of type unsigned is 0.
  while cursor plus width less than or equal to size {
    dynamic matches is true.
    dynamic index of type unsigned is 0.
    while index less than width {
      when content at (cursor plus index) is not separator at index {
        set matches to false.
        stop.
      }
      set index to index plus 1.
    }
    when matches {
      constant part is slice(content, first, cursor) try.
      set result at position to part.
      set position to position plus 1.
      set cursor to cursor plus width.
      set first to cursor.
    } otherwise {
      set cursor to cursor plus 1.
    }
  }
  set result at position to slice(content, first, size) try.
  give result.
}

-- Source: test/library/collections.iv
-- Exercises typed sequence operations and function-valued transformations.
use sequence as sequence.
use testing as check.
use map as mapping.
use table as fast.
use set as unique.
use queue as queue.
use stack as stack.
use text as words.
function double(value integer) giving integer {
  give value multiply 2.
}
function positive(value integer) giving boolean {
  give value is greater than 0.
}
function negative(value integer) giving boolean {
  give value is less than 0.
}
function add(left integer, right integer) giving integer {
  give left plus right.
}
define Person as record {
  name of type text.
  age of type integer.
} derives Equatable, Ord.
start {
  constant missing of type optional integer is null.
  check.expect(missing is null).
  constant empty is sequence.create[integer].
  constant first is sequence.append[integer](empty, 4) try.
  constant second is sequence.append[integer](first, 2) try.
  constant repeated is sequence.append[integer](second, 4) try.
  constant sorted is sequence.sort(second) try.
  constant deduplicated is sequence.dedup[integer](repeated) try.
  after {
    sequence.release[integer](first) fallback nothing.
    sequence.release[integer](second) fallback nothing.
    sequence.release[integer](repeated) fallback nothing.
    sequence.release[integer](sorted) fallback nothing.
    sequence.release[integer](deduplicated) fallback nothing.
  }
  check.expect(sorted at 0 is 2).
  check.expect(second at 0 is 4).
  check.expect(sequence.find[integer](sorted, 4) is not null).
  check.expect(sequence.length[integer](deduplicated) is 2).
  constant reversed is sequence.reverse[integer](second) try.
  constant taken is sequence.take[integer](second, 1) try.
  constant dropped is sequence.drop[integer](second, 1) try.
  after {
    sequence.release[integer](reversed) fallback nothing.
    sequence.release[integer](taken) fallback nothing.
    sequence.release[integer](dropped) fallback nothing.
  }
  check.expect(reversed at 0 is 2).
  check.expect(taken at 0 is 4).
  check.expect(dropped at 0 is 2).
  check.expect(sequence.any[integer](second, positive)).
  check.expect(sequence.all[integer](second, positive)).
  check.expect(sequence.fold[integer, integer](second, 0, add) is 6).
  dynamic growing is sequence.create[integer].
  dynamic number is 0.
  while number is less than 12 {
    set growing to sequence.append[integer](growing, number) try.
    set number to number plus 1.
  }
  constant snapshot is growing.
  constant noise is words.concatenate("mixed", "allocation") try.
  set growing to sequence.append[integer](growing, 12) try.
  words.release(noise) try.
  constant branch is sequence.append[integer](snapshot, 99) try.
  after {
    sequence.release[integer](growing) fallback nothing.
    sequence.release[integer](branch) fallback nothing.
  }
  check.expect(sequence.length[integer](snapshot) is 12).
  check.expect(snapshot at 11 is 11).
  check.expect(growing at 12 is 12).
  check.expect(branch at 12 is 99).
  constant mapped is sequence.map[integer, integer](sorted, double) try.
  constant filtered is sequence.filter[integer](mapped, positive) try.
  constant rejected is sequence.filter[integer](mapped, negative) try.
  after {
    sequence.release[integer](mapped) fallback nothing.
    sequence.release[integer](filtered) fallback nothing.
    sequence.release[integer](rejected) fallback nothing.
  }
  check.expect(filtered at 1 is 8).
  check.expect(sequence.length[integer](rejected) is 0).
  constant table is mapping.create[text, integer].
  constant entry is mapping.put[text, integer](table, "answer", 44) try.
  constant replaced is mapping.put[text, integer](entry, "answer", 42) try.
  after {
    mapping.release[text, integer](entry) fallback nothing.
    mapping.release[text, integer](replaced) fallback nothing.
  }
  check.expect((mapping.get[text, integer](entry, "answer") try) is 44).
  check.expect((mapping.get[text, integer](replaced, "answer") try) is 42).
  check.expect(mapping.length[text, integer](replaced) is 1).
  constant keys is mapping.keys[text, integer](replaced) try.
  constant values is mapping.values[text, integer](replaced) try.
  after {
    sequence.release[text](keys) fallback nothing.
    sequence.release[integer](values) fallback nothing.
  }
  check.same(keys at 0, "answer").
  check.expect(values at 0 is 42).
  constant cache is fast.create[integer] try.
  after {
    fast.close[integer](cache) fallback nothing.
  }
  fast.put[integer](cache, "answer", 44) try.
  fast.put[integer](cache, "answer", 42) try.
  check.expect((fast.get[integer](cache, "answer") try) is 42).
  check.expect((fast.length[integer](cache) try) is 1).
  check.expect(fast.contains[integer](cache, "answer") try).
  check.expect(fast.remove[integer](cache, "answer") try).
  check.expect((fast.length[integer](cache) try) is 0).
  constant set is unique.create[integer].
  constant member is unique.insert[integer](set, 44) try.
  constant duplicate is unique.insert[integer](member, 44) try.
  after {
    unique.release[integer](member) fallback nothing.
    unique.release[integer](duplicate) fallback nothing.
  }
  check.expect(unique.length[integer](duplicate) is 1).
  constant line is queue.create[integer].
  constant front is queue.append[integer](line, 44) try.
  after {
    queue.release[integer](front) fallback nothing.
  }
  check.expect((queue.first[integer](front) try) is 44).
  constant pile is stack.create[text].
  constant top is stack.push[text](pile, "FOO") try.
  after {
    stack.release[text](top) fallback nothing.
  }
  check.same(stack.top[text](top) try, "FOO").
  constant people is unique.create[Person].
  constant person is unique.insert[Person](people, Person("Ada", 44)) try.
  after {
    unique.release[Person](person) fallback nothing.
  }
  check.expect(unique.contains[Person](person, Person("Ada", 44))).
  check.expect(not unique.contains[Person](person, Person("Ada", 43))).
  constant removed is mapping.remove[text, integer](entry, "answer") try.
  constant absent is unique.remove[integer](duplicate, 44) try.
  after {
    mapping.release[text, integer](removed) fallback nothing.
    unique.release[integer](absent) fallback nothing.
  }
  check.expect(mapping.length[text, integer](removed) is 0).
  check.expect(unique.length[integer](absent) is 0).
  check.expect(sequence.find[integer](empty, 0) is null).
  constant back is queue.append(front, 42) try.
  constant tail is queue.remove[integer](back) try.
  after {
    queue.release[integer](back) fallback nothing.
    queue.release[integer](tail) fallback nothing.
  }
  check.expect((queue.first[integer](back) try) is 44).
  check.expect((queue.first[integer](tail) try) is 42).
  constant peak is stack.push[text](top, "IV") try.
  constant lower is stack.remove[text](peak) try.
  after {
    stack.release[text](peak) fallback nothing.
    stack.release[text](lower) fallback nothing.
  }
  check.same(stack.top[text](peak) try, "IV").
  check.same(stack.top[text](lower) try, "FOO").
  constant records is sequence.create[Person].
  constant older is sequence.append(records, Person("Ada", 44)) try.
  constant younger is sequence.append(older, Person("Ada", 43)) try.
  constant ordered is sequence.sort(younger) try.
  after {
    sequence.release(older) fallback nothing.
    sequence.release(younger) fallback nothing.
    sequence.release(ordered) fallback nothing.
  }
  check.expect(ordered at 0 is Person("Ada", 43)).
  check.expect((mapping.get[text, integer](entry, "absent") fallback 99) is 99).
  check.expect((stack.top[text](pile) fallback "empty") is "empty").
}

