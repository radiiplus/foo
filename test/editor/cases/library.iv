-- Exercises portable files, text, clocks, threads, and TCP connections.
use io as io.
use file as files.
use net as network.
use dns as names.
use adapter as devices.
use route as paths.
use "../../lib/process.iv" as process.
use "../../lib/resource.iv" as usage.
use thread as tasks.
use task as jobs.
use time as clock.
use text as words.
use sequence as items.
use log as log.
use testing as check.
extern "C" function verify giving nothing.
dynamic count of type integer is 0.
function pulse giving nothing {
  set count to count plus 1.
  give nothing.
}
function accumulate(value integer) giving nothing for c {
  set count to count plus value.
  give nothing.
}
function probe giving failable nothing {
  constant answers is names.query("localhost", "a") try.
  after { names.close(answers) fallback nothing. }
  check.expect((names.count(answers) try) is greater than 0).
  check.expect(words.length(names.name(answers, 0) try) is greater than 0).
  check.expect(words.length(names.data(answers, 0) try) is greater than 0).
  check.expect(words.length(names.kind(answers, 0) try) is greater than 0).
  constant ttl is names.ttl(answers, 0) try.
  check.expect(ttl is less than 18446744073709551615).
}
start {
  constant joined is words.concatenate("FO", "O") try.
