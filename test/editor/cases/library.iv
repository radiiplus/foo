  check.expect(payload at 0 is 0).
  check.expect(payload at 1 is 42).
  check.expect(payload at 2 is 255).
  check.same(network.sender(packet) try, "127.0.0.1").
  check.expect((network.origin(packet) try) is (network.local(sender) try)).
  constant typed is network.sender4(packet) try.
