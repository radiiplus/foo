  after {
    io.close(file) fallback nothing.
  }
  check.expect((files.position(file) try) is 0).
  check.expect((files.size(file) try) is 6).
  files.seek(file, (0 subtract 2), "end") try.
  check.expect((files.position(file) try) is 4).
  constant tail is io.read(file, 2) try.
  after {
    words.release(tail) fallback nothing.
  }
  check.same(tail, "44").
  files.seek(file, 0, "start") try.
  files.flush(file) try.
  constant line is io.line(file) try.
  after {
    words.release(line) fallback nothing.
  }
  check.same(line, "FOO").
  constant draft is files.join(".artifacts/service", "draft.bin") try.
  constant published is files.join(".artifacts/service", "published.bin") try.
  after {
    words.release(draft) fallback nothing.
    words.release(published) fallback nothing.
  }
  constant output is files.open(draft, "write") try.
  io.write(output, "stable") try.
  files.flush(output) try.
  files.sync(output) try.
  io.close(output) try.
  files.replace(draft, published) try.
  constant stored is files.read(published) try.
  after { words.release(stored) fallback nothing. }
  check.same(stored, "stable").
  constant bytes is files.load(published) try.
  check.expect(items.length[byte](bytes) is 6).
  constant copied is files.join(".artifacts/service", "copied.bin") try.
  after { words.release(copied) fallback nothing. }
  files.copy(published, copied) try.
  files.release(bytes) try.
  constant actual is files.read(copied) try.
  after { words.release(actual) fallback nothing. }
  check.same(actual, "stable").
  files.remove(copied) try.
  check.expect(not (files.exists(copied) try)).
  files.remove(published) try.
  check.same(files.read(published) fallback "removed", "removed").
  constant missing is files.read(".artifacts/service/missing") fallback "missing".
  check.same(missing, "missing").
  check.expect(process.count is greater than 0).
  check.expect((process.run("exit 7") try) is 7).
  constant empty is items.create[text].
  constant flag is items.append[text](empty, "-e") try.
  constant arguments is items.append[text](flag, "process.exit(0)") try.
  after {
