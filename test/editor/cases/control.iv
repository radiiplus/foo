-- Exercises lexical tokens and literal forms.
--- this is a
multiline comment ---
public constant x of type integer 32 is 42.
dynamic y of type decimal is 3.14.
    constant greeting of type text is "I'm saying \"hello\"".
    constant message of type text is "line one" plus newline plus "line two".
    constant c of type character is 'a'.

    public function add(a integer 32, b integer 32) {
        give a plus b.
    }

    define Point as record {
        x of type decimal.
        y of type decimal.
    }.

    define Color as choice {
        Red.
        Green is 5.
        Blue.
    }.

    extern "C" function puts(s pointer to byte) giving integer 32.

    start {
        when true {
            constant z is 1.
        } otherwise {
            constant z is 2.
        }

        while false {
        }

        for each item in items {
            process item.
        }

        match x {
            case 1 {
                give nothing.
            }
            case anything {
                unreachable.
            }
        }

        constant maybe of type optional integer 32 is uninitialized.
        constant result is maybe fallback 0.
        constant item of type core.reference is uninitialized.

        measure try.

        after { close file. }

        unsafe {
            constant location of type pointer to integer is 0.
        }

        give nothing.
    }
