-- Exercises interop fixtures behavior.

  use c "native.h".

  function foo_callback(value of type integer 32) of type integer 32 for c {
    give value plus 7.
  }

  start() {
    constant callback is get_c_callback().
    constant from_c of type integer 32 is callback(5).
    verify_callbacks(foo_callback, from_c).
    give.
  }

