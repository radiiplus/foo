-- Calls an installed C library through generated bindings without editing them.
use c "/usr/include/sodium/crypto_verify_16.h".
use memory as heap.
use testing as check.
start() {
  check.expect(crypto_verify_16_bytes() is crypto_verify_16_BYTES).
  constant owner is heap.system().
  constant left is heap.allocate(owner, 16) try.
  constant right is heap.allocate(owner, 16) try.
  after {
    heap.release(owner, left) fallback nothing.
    heap.release(owner, right) fallback nothing.
  }
  check.expect(crypto_verify_16(left, right) is 0).
  heap.copy(owner, right, "FOO") try.
  check.expect(crypto_verify_16(left, right) is not 0).
}
