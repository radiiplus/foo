-- Exercises parse fixtures behavior.

  public constant x of type integer 32 is 42.
  public dynamic y of type decimal is 3.14.
  dynamic counter of type integer 32 is 0.
  
  public function add(a integer 32, b integer 32) {
    give a plus b.
  }
  
  define Point as record {
    x of type decimal.
    y of type decimal.
  }.
  
  define Color as choice {
    Red.
    Green is 5.
    Blue.
  }.
  
  use file.
  
  start {
    when true {
      constant z is 1.
    } otherwise {
      constant z is 2.
    }
    
    while counter less than 10 {
      set counter to counter plus 1.
    }
    
    for each item in items {
      process item.
    }
    
    match x {
      case 1 {
        give nothing.
      }
      case anything {
        unreachable.
      }
    }
    
    constant maybe of type optional integer 32 is uninitialized.
    constant result is maybe fallback 0.
    
    after { close file. }
    
    unsafe {
      constant location of type pointer to integer is 0.
    }
    
    give nothing.
  }
