-- Checks machine-gated atomic, bit and register operations.
use testing as check.
dynamic counter of type unsigned is 43.
start() {
  atomic add counter by 1.
  check.expect(counter is 44).
  dynamic flag of type unsigned is 0.
  bits set flag at position 4.
  check.expect(flag is 16).
  bits clear flag at position 4.
  check.expect(flag is 0).
  dynamic buffer is allocate 64 try.
  memory align buffer to 1.
  register rax is 44.
}
