{
  "name": "foo",
  "version": "0.6.0",
  "bin": {
    "foo": "bin/foo.mjs"
  },
  "scripts": {
    "test": "node test/stdlib/check.mjs && node test/native/run.mjs",
    "test:stdlib": "node test/stdlib/check.mjs && node bin/foo.mjs test std --backend c",
    "test:docs": "node test/docs/run.mjs",
    "test:build": "node test/native/run.mjs",
    "foo": "node bin/foo.mjs",
    "postinstall": "node tools/toolchain.mjs",
    "check": "node tools/native.mjs --check",
    "export": "node tools/export.mjs",
    "test:editor": "node test/editor/run.mjs && node test/editor/snapshots.mjs && node test/editor/theme.mjs && node test/editor/probe.mjs",
    "test:host": "node test/editor/editor.mjs",
    "build": "node tools/build.mjs",
    "binaries": "node tools/binaries.mjs",
    "binaries:signed": "node --env-file=.env.sign tools/binaries.mjs --sign",
    "build:installers": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build.ps1",
    "key": "node tools/key.mjs",
    "key:preview": "node tools/key.mjs --preview",
    "sign": "node tools/sign.mjs",
    "native:build": "node tools/native.mjs",
    "test:native": "node test/native/run.mjs",
    "benchmark": "node bin/foo.mjs benchmark --warmup 3 --iterations 20",
    "benchmark:report": "node tools/benchmark.mjs"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "description": "FOO language compiler and managed native toolchain",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/radiiplus/foo.git"
  },
  "homepage": "https://github.com/radiiplus/foo#readme",
  "bugs": {
    "url": "https://github.com/radiiplus/foo/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {},
  "files": [
    "LICENSE",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "CHANGELOG.md",
    "bin/",
    "assets/",
    "src/",
    "std/",
    "docs/",
    "tools/toolchain.mjs",
    "tools/native.mjs",
    "tools/benchmark.mjs",
    "toolchain.json",
    "project.json",
    "specs/",
    "benchmark/",
    "test/stdlib/*.iv",
    "test/stdlib/project.json",
    "test/stdlib/public.txt",
    "test/native/service.c"
  ]
}
