{
  "name": "foo",
  "version": "1.0.0",
  "bin": {
    "foo": "bin/foo.mjs"
  },
  "scripts": {
    "test:library": "node test/library/check.mjs && node bin/foo.mjs test lib --backend qbe",
    "test:docs": "node test/docs/links.mjs && node test/docs/run.mjs",
    "foo": "node bin/foo.mjs",
    "check": "node tools/native.mjs --check",
    "export": "node tools/export.mjs",
    "highlight": "node tools/highlight.mjs",
    "test:editor": "node test/run.mjs editor",
    "test:host": "node test/editor/editor.mjs",
    "build": "node tools/build.mjs",
    "source:pack": "node tools/source.mjs",
    "binaries": "node tools/binaries.mjs",
    "binaries:signed": "node --env-file=.env.sign tools/binaries.mjs --sign",
    "build:installers": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build.ps1",
    "key": "node tools/key.mjs",
    "key:preview": "node tools/key.mjs --preview",
    "sign": "node tools/sign.mjs",
    "native:build": "node tools/native.mjs",
    "benchmark": "node bin/foo.mjs benchmark --warmup 3 --iterations 20",
    "benchmark:report": "node tools/benchmark.mjs",
    "registry:standard": "node tools/catalog.mjs",
    "registry:standard:check": "node tools/catalog.mjs --check",
    "vendor:audit": "node tools/vendor/audit.mjs --artifacts",
    "vendor:build": "node tools/vendor/build.mjs",
    "toolchain:cross-zig": "node tools/toolchain.mjs",
    "vendor:verify": "node tools/vendor/verify.mjs",
    "test:coverage": "node test/support/audit.mjs",
    "test:qbe": "node test/matrix.mjs --backends qbe --modes dev",
    "test:qbe-bundle": "node tools/qbe/verify.mjs",
    "test:semantics": "node test/matrix.mjs --gate",
    "test:core": "node test/run.mjs core",
    "test:net": "node test/run.mjs net",
    "test:runtime": "node test/run.mjs runtime",
    "test:targets": "node test/run.mjs targets",
    "test:packages": "node test/run.mjs packages",
    "test:release": "node test/run.mjs release",
    "test:bench": "node test/run.mjs bench",
    "test:changed": "node test/run.mjs changed",
    "test:harness": "node test/backend-policy.mjs && node test/harness.mjs && node test/regional.mjs"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "description": "FOO language compiler and managed native toolchain",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/radiiplus/foo.git"
  },
  "homepage": "https://github.com/radiiplus/foo#readme",
  "bugs": {
    "url": "https://github.com/radiiplus/foo/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {},
  "files": [
    "LICENSE",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "CHANGELOG.md",
    "bin/",
    "assets/",
    "src/",
    "lib/",
    "vendor/",
    "docs/",
    "toolchain.json",
    "toolchain/",
    "project.ivc",
    "specs/",
    "benchmark/",
    "registry/standard.json",
    "test/library/**/*.iv",
    "test/library/project.ivc",
    "test/library/public.txt",
    "test/native/c/service.c",
    "tools/"
  ]
}
