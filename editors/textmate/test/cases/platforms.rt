module windows {
  --- Windows-only handles with portable Tratio names. ---
  public type Handle is opaque.
  public type Registry is opaque.
  public type Winrt is opaque.

  public function handle() {
    constant result of type pointer to Handle is uninitialized.
    give result.
  }

  public function process(command of type pointer to byte) {
    constant result of type pointer to Handle is uninitialized.
    give result.
  }

  public function registry(path of type pointer to byte) {
    constant result of type pointer to Registry is uninitialized.
    give result.
  }

  public function winrt(class of type pointer to byte) {
    constant result of type pointer to Winrt is uninitialized.
    give result.
  }

  public function release(handle of type pointer to Handle) {
    give.
  }
}
