{
  "function": {
    "prefix": "function",
    "body": ["function ${1:name} ${2:value} ${3:integer} giving ${4:integer} {", "  $0", "}"],
    "description": "FOO sentence-style function"
  },
  "start": {
    "prefix": "start",
    "body": ["start() {", "  $0", "}"],
    "description": "FOO explicit entry point"
  },
  "test": {
    "prefix": "test",
    "body": ["test \"${1:name}\" {", "  $0", "}"],
    "description": "FOO test block"
  },
  "when": {
    "prefix": "when",
    "body": ["when ${1:condition} {", "  $0", "} otherwise {", "  ", "}"],
    "description": "FOO when/otherwise"
  },
  "for each": {
    "prefix": "for each",
    "body": ["for each ${1:item} in ${2:items} {", "  $0", "}"],
    "description": "FOO for each loop"
  },
  "while": {
    "prefix": "while",
    "body": ["while ${1:condition} {", "  $0", "}"],
    "description": "FOO while loop"
  },
  "match": {
    "prefix": "match",
    "body": ["match ${1:value} {", "  case ${2:pattern} {", "    $0", "  }", "}"],
    "description": "FOO pattern match"
  },
  "constant": {
    "prefix": "constant",
    "body": ["constant ${1:name} is ${0:value}."],
    "description": "FOO constant"
  },
  "dynamic": {
    "prefix": "dynamic",
    "body": ["dynamic ${1:name} is ${0:value}."],
    "description": "FOO dynamic binding"
  },
  "define": {
    "prefix": "define",
    "body": ["define ${1:Name} as ${0:integer}."],
    "description": "FOO named type"
  },
  "increase": {
    "prefix": "increase",
    "body": ["increase ${1:value} by ${0:1}."],
    "description": "Increase a dynamic value"
  },
  "decrease": {
    "prefix": "decrease",
    "body": ["decrease ${1:value} by ${0:1}."],
    "description": "Decrease a dynamic value"
  },
  "try": {
    "prefix": "try",
    "body": ["${1:operation} try."],
    "description": "Propagate a failable operation"
  },
  "fallback": {
    "prefix": "fallback",
    "body": ["${1:operation} fallback ${0:value}."],
    "description": "Recover from a failable operation"
  }
}
