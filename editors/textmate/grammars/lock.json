{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "FOO Lockfile",
  "scopeName": "source.foo.ivl",
  "fileTypes": ["ivl"],
  "patterns": [
    { "include": "#key" },
    { "include": "#value" }
  ],
  "repository": {
    "key": {
      "name": "variable.other.property.foo.ivl",
      "match": "\"(?:\\\\.|[^\"\\\\])*\"(?=\\s*:)"
    },
    "value": {
      "patterns": [
        { "name": "string.quoted.double.foo.ivl", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.foo.ivl", "match": "\\\\(?:[\"\\\\/bfnrt]|u[0-9a-fA-F]{4})" }] },
        { "name": "constant.numeric.foo.ivl", "match": "(?<![A-Za-z0-9_.-])-?[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?\\b" },
        { "name": "constant.language.foo.ivl", "match": "\\b(?:true|false|null)\\b" },
        { "name": "punctuation.separator.foo.ivl", "match": "[:,]" },
        { "name": "punctuation.section.foo.ivl", "match": "[{}\\[\\]]" },
        { "include": "#key" }
      ]
    }
  }
}
