-- Stores typed key/value pairs with equality-based lookup.
use sequence as items.
public define Entry[K, V] as record {
  key of type K.
  value of type V.
}.
public define Map[K, V] as record {
  entries of type sequence of Entry[K, V].
}.
public function create[K, V] giving Map[K, V] {
  give Map[K, V](items.create[Entry[K, V]]).
}
public function length[K, V](collection Map[K, V]) giving unsigned {
  give items.length[Entry[K, V]](collection.entries).
}
public function get[K, V](collection Map[K, V], key K) giving failable V where K is Equatable {
  for each entry in collection.entries {
    when entry.key is key {
      give entry.value.
    }
  }
  give fail(Error.MissingKey).
}
public function contains[K, V](collection Map[K, V], key K) giving boolean where K is Equatable {
  for each entry in collection.entries {
    when entry.key is key {
      give true.
    }
  }
  give false.
}
public function put[K, V](collection Map[K, V], key K, value V) giving failable Map[K, V] where K is Equatable {
  dynamic index of type unsigned is 0.
  for each entry in collection.entries {
    when entry.key is key {
      dynamic result is items.copy[Entry[K, V]](collection.entries) try.
      set result at index to Entry[K, V](key, value).
      give Map[K, V](result).
    }
    set index to index plus 1.
  }
  give Map[K, V](items.append[Entry[K, V]](collection.entries, Entry[K, V](key, value)) try).
}
public function remove[K, V](collection Map[K, V], key K) giving failable Map[K, V] where K is Equatable {
  dynamic index of type unsigned is 0.
  for each entry in collection.entries {
    when entry.key is key {
      give Map[K, V](items.remove[Entry[K, V]](collection.entries, index) try).
    }
    set index to index plus 1.
  }
  give Map[K, V](items.copy[Entry[K, V]](collection.entries) try).
}
public function keys[K, V](collection Map[K, V]) giving failable sequence of K {
  dynamic result is items.sized[K](length[K, V](collection)) try.
  after error { items.release[K](result) fallback nothing. }
  dynamic index of type unsigned is 0.
  for each entry in collection.entries {
    set result at index to entry.key.
    increase index by 1.
  }
  give result.
}
public function values[K, V](collection Map[K, V]) giving failable sequence of V {
  dynamic result is items.sized[V](length[K, V](collection)) try.
  after error { items.release[V](result) fallback nothing. }
  dynamic index of type unsigned is 0.
  for each entry in collection.entries {
    set result at index to entry.value.
    increase index by 1.
  }
  give result.
}
public function release[K, V](collection Map[K, V]) giving failable nothing {
  items.release[Entry[K, V]](collection.entries) try.
  give nothing.
}
