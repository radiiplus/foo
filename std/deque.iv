-- Defines double-ended collections.
--- Double-ended queue ---
--- Efficient insertion/removal at both ends ---
public define Deque as record {
  data of type pointer to byte.
  length of type integer.
}.
public function create() {
  constant result of type Deque is uninitialized.
  give result.
}
public function front(collection Deque, value pointer to byte) {
  give nothing.
}
public function back(collection Deque, value pointer to byte) {
  give nothing.
}
public function shift(collection Deque) {
  constant result of type pointer to byte is uninitialized.
  give result.
}
public function pop(collection Deque) {
  constant result of type pointer to byte is uninitialized.
  give result.
}
