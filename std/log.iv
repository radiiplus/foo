-- Writes application messages and errors to the diagnostic stream.
use io as output.
public function message(content text) giving failable nothing { try output.write(output.report(), "INFO  " plus content plus newline). give. }
public function error(content text) giving failable nothing { try output.write(output.report(), "ERROR " plus content plus newline). give. }
public function note(content text) giving nothing { output.write(output.report(), "INFO  " plus content plus newline) fallback nothing. }
public function alert(content text) giving nothing { output.write(output.report(), "ERROR " plus content plus newline) fallback nothing. }
