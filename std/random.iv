-- Provides random values.
--- Random number generation ---
--- OS-backed and PRNG implementations ---
public define Random as record {
  state of type pointer to byte.
}.
public function default() {
  constant result of type Random is uninitialized.
  give result.
}
public function bytes(rng Random, buffer pointer to byte, size integer) {
  give nothing.
}
public function number(rng Random, minimum integer, maximum integer) {
  constant result of type integer is 0.
  give result.
}
