-- Builds typed sequences and applies ordering, searching, and transformations.
public use "sequence" function create[T]() of type sequence of T.
public use "sequence" function append[T](items of type sequence of T, value of type T) of type fallible sequence of T.
public use "sequence" function remove[T](items of type sequence of T, index of type unsigned 64) of type fallible sequence of T.
public use "sequence" function copy[T](items of type sequence of T) of type fallible sequence of T.
public use "sequence" function length[T](items of type sequence of T) of type unsigned 64.
public use "sequence" function release[T](items of type sequence of T) of type fallible nothing.
use "sequence" function sized[T](length unsigned 64) giving fallible sequence of T.
use "sequence" function compact[T](items sequence of T, length unsigned 64) giving fallible sequence of T.

public function find[T](items of type sequence of T, value of type T) of type optional unsigned 64 where T is Equatable {
  dynamic index of type unsigned 64 is 0.
  for each item in items {
    when item is value { give index. }
    set index to index plus 1.
  }
  give nothing.
}

public function sort[T](items of type sequence of T) of type fallible sequence of T where T is Ord {
  dynamic result is try copy[T](items).
  dynamic index of type unsigned 64 is 1.
  while index less than length[T](result) {
    constant value is result at index.
    dynamic cursor is index.
    while cursor greater than 0 {
      when result at (cursor subtract 1) greater than value {
        set result at cursor to result at (cursor subtract 1).
        set cursor to cursor subtract 1.
      } otherwise { stop. }
    }
    set result at cursor to value.
    set index to index plus 1.
  }
  give result.
}

public function filter[T](items of type sequence of T, predicate of type function taking (T) giving boolean) of type fallible sequence of T {
  dynamic result is try sized[T](length[T](items)).
  after error { release[T](result) fallback nothing. }
  dynamic count of type unsigned 64 is 0.
  for each item in items {
    when predicate(item) {
      set result at count to item.
      set count to count plus 1.
    }
  }
  give try compact[T](result, count).
}

public function map[T, U](items of type sequence of T, transform of type function taking (T) giving U) of type fallible sequence of U {
  dynamic result is try sized[U](length[T](items)).
  after error { release[U](result) fallback nothing. }
  dynamic index is 0.
  for each item in items {
    set result at index to transform(item).
    set index to index plus 1.
  }
  give result.
}

public function deduplicate[T](items sequence of T) giving fallible sequence of T where T is Equatable {
  dynamic result is try sized[T](length[T](items)).
  after error { release[T](result) fallback nothing. }
  dynamic count of type unsigned 64 is 0.
  for each item in items {
    dynamic present is false.
    dynamic cursor of type unsigned 64 is 0.
    while cursor less than count {
      when result at cursor is item {
        set present to true.
        stop.
      }
      set cursor to cursor plus 1.
    }
    when not present {
      set result at count to item.
      set count to count plus 1.
    }
  }
  give try compact[T](result, count).
}

public function dedup[T](items sequence of T) giving fallible sequence of T where T is Equatable {
  give try deduplicate[T](items).
}
