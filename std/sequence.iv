-- Builds typed sequences and applies ordering, searching, and transformations.
public use "sequence" function create[T] giving sequence of T.
public use "sequence" function append[T](items sequence of T, value T) giving failable sequence of T.
public use "sequence" function remove[T](items sequence of T, index unsigned) giving failable sequence of T.
public use "sequence" function copy[T](items sequence of T) giving failable sequence of T.
public use "sequence" function length[T](items sequence of T) giving unsigned.
public use "sequence" function release[T](items sequence of T) giving failable nothing.
public use "sequence" function sized[T](length unsigned) giving failable sequence of T.
use "sequence" function compact[T](items sequence of T, length unsigned) giving failable sequence of T.
public function find[T](items sequence of T, value T) giving optional unsigned where T is Equatable {
  dynamic index of type unsigned is 0.
  for each item in items {
    when item is value {
      give index.
    }
    set index to index plus 1.
  }
  give null.
}
public function sort[T](items sequence of T) giving failable sequence of T where T is Ord {
  dynamic result is copy[T](items) try.
  dynamic index of type unsigned is 1.
  while index less than length[T](result) {
    constant value is result at index.
    dynamic cursor is index.
    while cursor greater than 0 {
      when result at (cursor subtract 1) greater than value {
        set result at cursor to result at (cursor subtract 1).
        set cursor to cursor subtract 1.
      } otherwise {
        stop.
      }
    }
    set result at cursor to value.
    set index to index plus 1.
  }
  give result.
}
public function filter[T](items sequence of T, predicate function taking (T) giving boolean) giving failable sequence of T {
  dynamic result is sized[T](length[T](items)) try.
  after error {
    release[T](result) fallback nothing.
  }
  dynamic count of type unsigned is 0.
  for each item in items {
    when predicate(item) {
      set result at count to item.
      set count to count plus 1.
    }
  }
  give compact[T](result, count) try.
}
public function map[T, U](items sequence of T, transform function taking (T) giving U) giving failable sequence of U {
  dynamic result is sized[U](length[T](items)) try.
  after error {
    release[U](result) fallback nothing.
  }
  dynamic index is 0.
  for each item in items {
    set result at index to transform(item).
    set index to index plus 1.
  }
  give result.
}
public function reverse[T](items sequence of T) giving failable sequence of T {
  constant count is length[T](items).
  dynamic result is sized[T](count) try.
  after error { release[T](result) fallback nothing. }
  dynamic index of type unsigned is 0.
  while index less than count {
    set result at index to items at (count subtract index subtract 1).
    increase index by 1.
  }
  give result.
}
public function any[T](items sequence of T, predicate function taking (T) giving boolean) giving boolean {
  for each item in items {
    when predicate(item) { give true. }
  }
  give false.
}
public function all[T](items sequence of T, predicate function taking (T) giving boolean) giving boolean {
  for each item in items {
    when not predicate(item) { give false. }
  }
  give true.
}
public function fold[T, U](items sequence of T, initial U, combine function taking (U, T) giving U) giving U {
  dynamic result is initial.
  for each item in items {
    set result to combine(result, item).
  }
  give result.
}
public function take[T](items sequence of T, count unsigned) giving failable sequence of T {
  when count greater than length[T](items) { give fail(Error.Bounds). }
  dynamic result is sized[T](count) try.
  after error { release[T](result) fallback nothing. }
  dynamic index of type unsigned is 0.
  while index less than count {
    set result at index to items at index.
    increase index by 1.
  }
  give result.
}
public function drop[T](items sequence of T, count unsigned) giving failable sequence of T {
  when count greater than length[T](items) { give fail(Error.Bounds). }
  constant remaining is length[T](items) subtract count.
  dynamic result is sized[T](remaining) try.
  after error { release[T](result) fallback nothing. }
  dynamic index of type unsigned is 0.
  while index less than remaining {
    set result at index to items at (count plus index).
    increase index by 1.
  }
  give result.
}
public function deduplicate[T](items sequence of T) giving failable sequence of T where T is Equatable {
  dynamic result is sized[T](length[T](items)) try.
  after error {
    release[T](result) fallback nothing.
  }
  dynamic count of type unsigned is 0.
  for each item in items {
    dynamic present is false.
    dynamic cursor of type unsigned is 0.
    while cursor less than count {
      when result at cursor is item {
        set present to true.
        stop.
      }
      set cursor to cursor plus 1.
    }
    when not present {
      set result at count to item.
      set count to count plus 1.
    }
  }
  give compact[T](result, count) try.
}
public function dedup[T](items sequence of T) giving failable sequence of T where T is Equatable {
  give deduplicate[T](items) try.
}
