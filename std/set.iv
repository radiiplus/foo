-- Keeps each typed value once using equality-based membership.
use sequence as items.
public define Set[T] as record {
  values of type sequence of T.
}.
public function create[T]() giving Set[T] {
  give Set[T](items.create[T]()).
}
public function length[T](collection Set[T]) giving unsigned {
  give items.length[T](collection.values).
}
public function contains[T](collection Set[T], value T) giving boolean where T is Equatable {
  for each item in collection.values {
    when item is value {
      give true.
    }
  }
  give false.
}
public function insert[T](collection Set[T], value T) giving failable Set[T] where T is Equatable {
  when contains[T](collection, value) {
    give Set[T](items.copy[T](collection.values) try).
  }
  give Set[T](items.append[T](collection.values, value) try).
}
public function remove[T](collection Set[T], value T) giving failable Set[T] where T is Equatable {
  dynamic index of type unsigned is 0.
  for each item in collection.values {
    when item is value {
      give Set[T](items.remove[T](collection.values, index) try).
    }
    set index to index plus 1.
  }
  give Set[T](items.copy[T](collection.values) try).
}
public function release[T](collection Set[T]) giving failable nothing {
  items.release[T](collection.values) try.
  give nothing.
}
